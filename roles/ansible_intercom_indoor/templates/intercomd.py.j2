    status = await r.json();
    render();
    const ev = await (await fetch('/api/events?limit=50')).json();
    renderEvents(ev);
    document.getElementById('footer').textContent =
      'intercomd \u00b7 Metrics: /metrics \u00b7 API: /api/status';
  } catch (e) {
    document.getElementById('toast').textContent = 'Aktualisierung fehlgeschlagen';
  }
}

async function restartApp() {
  const btn = document.getElementById('btn-restart');
  btn.disabled = true;
  document.getElementById('toast').textContent = '';
  try {
    const r = await fetch('/api/app/restart', {method: 'POST'});
    const j = await r.json();
    document.getElementById('toast').textContent =
      j.ok ? 'App-Neustart angestossen' : 'App-Neustart fehlgeschlagen';
  } catch (e) {
    document.getElementById('toast').textContent = 'Fehler: ' + e;
  }
  btn.disabled = false;
  setTimeout(refresh, 4000);
}

const SEG = 24, LEVEL_MIN = -60, LEVEL_MAX = 0;
function renderLevel(l) {
  const el = document.getElementById('meter');
  const val = document.getElementById('level-value');
  if (!el || !val) return;
  if (el.children.length !== SEG) {
    let h = '';
    for (let i = 0; i < SEG; i++) h += '<i></i>';
    el.innerHTML = h;
  }
  if (!l || l.dbfs === null || l.dbfs === undefined) {
    for (let i = 0; i < SEG; i++) el.children[i].className = '';
    val.textContent = l && l.error ? 'Fehler: ' + l.error : 'keine Messung';
    return;
  }
  const frac = Math.max(0, Math.min(1, (l.dbfs - LEVEL_MIN) / (LEVEL_MAX - LEVEL_MIN)));
  const lit = Math.round(frac * SEG);
  for (let i = 0; i < SEG; i++) {
    const segDb = LEVEL_MIN + (LEVEL_MAX - LEVEL_MIN) * (i + 1) / SEG;
    const on = i < lit;
    el.children[i].className = on ? (segDb > -8 ? 'on r' : (segDb > -18 ? 'on y' : 'on')) : '';
  }
  val.textContent = l.dbfs.toFixed(1) + ' dBFS \u00b7 ~' + Math.round(l.db_spl) + ' dB SPL' +
    (l.peak_dbfs !== null && l.peak_dbfs !== undefined ? ' \u00b7 Peak ' + l.peak_dbfs.toFixed(1) + ' dB' : '');
}

