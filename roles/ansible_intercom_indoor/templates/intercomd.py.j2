m_up.set(1)

# --------------------------------------------------------- systemd-Zustaende
_svc_lock = threading.Lock()
_svc_cache = {"ts": 0.0, "app": False, "tx": False}


def refresh_services():
    """systemd-Zustaende von App + TX-Dienst abfragen (10-s-Cache)."""
    with _svc_lock:
        fresh = time.time() - _svc_cache["ts"] < 10.0
    if fresh:
        return
    for svc, key in ((APP_SERVICE, "app"), (TX_SERVICE, "tx")):
        try:
            r = subprocess.run(["systemctl", "is-active", "--quiet", svc],
                               timeout=5)
            ok = r.returncode == 0
        except Exception:
            ok = False
        with _svc_lock:
            _svc_cache[key] = ok
            _svc_cache["ts"] = time.time()


def update_metrics():
    """Alle Gauges setzen (bei /metrics und /api/status)."""
    refresh_services()
    with lock:
        call = state["call"]
        app = dict(app_state)
    with _svc_lock:
        app_up = _svc_cache["app"]
        tx_up = _svc_cache["tx"]
    m_app_up.set(1 if app_up else 0)
    m_tx.set(1 if tx_up else 0)
    m_call.set(1 if call == "active" else 0)
    m_ringing.set(1 if call == "ringing" else 0)
    m_mqtt.set(1 if mqtt_connected else 0)
    age = time.time() - app["ts"] if app["ts"] else None
    m_age.set(age if age is not None else -1)
    m_volume.set(app["volume"] if app["volume"] is not None else -1)
    m_hear.set(1 if app["hear"] else 0)
    m_speak.set(1 if app["speak"] else 0)
    m_vrestarts.set(app["video_restarts"]
                    if app["video_restarts"] is not None else 0)
    m_arestarts.set(app["audio_restarts"]
                    if app["audio_restarts"] is not None else 0)
    m_uptime.set(time.time() - STARTED_TS)


def status_snapshot():
    """Vollstaendiger Status als dict (GET /api/status)."""
    refresh_services()
    with lock:
        call = state["call"]
        app = dict(app_state)
    with _svc_lock:
        app_up = _svc_cache["app"]
        tx_up = _svc_cache["tx"]
    return {
        "call": call,
        "mqtt": {"connected": mqtt_connected, "broker": BROKER},
        "app": app,
        "services": {"app": app_up, "audio_tx": tx_up},
        "started_at": STARTED_AT,
        "uptime_s": round(time.time() - STARTED_TS, 1),
        "ts": int(time.time()),
    }


def record_event(event):
    entry = {"ts": time.time(),
             "time": datetime.now().astimezone().isoformat(timespec="seconds"),
             "event": event}
    with events_lock:
        door_events.append(entry)
    m_door_events.labels(event=event).inc()


def set_tx(enabled):
    try:
        subprocess.run(["systemctl", "start" if enabled else "stop", TX_SERVICE],
                       check=False, timeout=5)
    except Exception as e:
        print(f"tx control failed: {e}", flush=True)


def publish_state():
    with lock:
        payload = json.dumps(state)
    client.publish("intercom/indoor/intercombasement/state", payload, qos=1, retain=True)


def cancel_ring_timer():
    global ring_timer
    if ring_timer:
        ring_timer.cancel()
        ring_timer = None


def ring_timeout():
    global ring_timer
    with lock:
        if state["call"] != "ringing":
            ring_timer = None
            return
        state["call"] = "idle"
        state["ts"] = int(time.time())
        led_stop.set()
        if led:
            led.off()
    ring_timer = None
    publish_state()
    record_event("ring_timeout")
    print("ring timeout -> idle", flush=True)


def schedule_ring_timeout():
    global ring_timer
    cancel_ring_timer()
    ring_timer = threading.Timer(RING_TIMEOUT, ring_timeout)
    ring_timer.daemon = True
    ring_timer.start()


def blink_led():
    led_stop.clear()
    while not led_stop.is_set():
        if led:
            led.on()
        time.sleep(0.25)
        if led:
            led.off()
        time.sleep(0.25)


def on_connect(client, userdata, flags, rc, properties=None):
    global mqtt_connected
    if rc == 0:
        mqtt_connected = True
        client.subscribe("intercom/door/event", qos=1)
        publish_state()
        print("mqtt connected", flush=True)
    else:
        mqtt_connected = False


def on_disconnect(client, userdata, flags=None, rc=None, properties=None):
    global mqtt_connected
    mqtt_connected = False


def on_message(client, userdata, msg):
    try:
        payload = json.loads(msg.payload.decode())
    except Exception:
        return
    event = payload.get("event")
    with lock:
        if event == "ring":
            state["call"] = "ringing"
            state["ts"] = int(time.time())
            set_tx(False)
            led_stop.clear()
            if led:
                threading.Thread(target=blink_led, daemon=True).start()
            schedule_ring_timeout()
        elif event == "hangup":
            state["call"] = "idle"
            state["ts"] = int(time.time())
            set_tx(False)
            cancel_ring_timer()
            led_stop.set()
            if led:
                led.off()
    publish_state()
    record_event(event)
    print(f"door event: {event}", flush=True)


# ------------------------------------------------------------- App-Felder
def _app_field(field, value):
    """Feldwert fuer app_state validieren; None bei ungueltigem Wert."""
    try:
        if field in ("hear", "speak"):
            return bool(value)
        if field == "volume":
            return max(0, min(100, int(value)))
        if field in ("video_restarts", "audio_restarts"):
            return max(0, int(value))
        if field == "app_uptime_s":
            v = float(value)
            return v if v >= 0 else None
    except (TypeError, ValueError):
        return None
    return None


# ------------------------------------------------------- Schallpegel-Messung
class LevelMeter(threading.Thread):
    """Misst den RMS-Pegel (dBFS) des Mikrofoneingangs und schaetzt den
    Schalldruck. Ein ffmpeg-Prozess liest das Rohmikrofon (rawmic PCM,
    ohne AEC) und dieser Thread wertet 125-ms-Bloecke aus."""

    N = 2000  # Samples pro Block (125 ms bei 16 kHz)

    def __init__(self):
        super().__init__(daemon=True, name="level")
        self._lock = threading.Lock()
        self.data = {"dbfs": None, "db_spl": None, "peak_dbfs": None,
                     "error": "keine Messung"}
        self._smooth = None
        self._peak = None

    def run(self):
        import select
        n = self.N
        while True:
            proc = None
            try:
                # Rohmikrofon (rawmic PCM) direkt lesen — ohne AEC/NS,
                # damit die Anzeige den Mikrofon-Eingangspegel zeigt.
                env = dict(os.environ)
                env["XDG_RUNTIME_DIR"] = LEVEL_XDG_RUNTIME
                proc = subprocess.Popen(
                    ["ffmpeg", "-hide_banner", "-loglevel", "error",
                     "-f", "alsa", "-i", LEVEL_SOURCE,
                     "-f", "s16le", "-ar", "16000",
                     "-ac", "1", "-"],
                    stdout=subprocess.PIPE, env=env)
                fd = proc.stdout.fileno()
                buf = bytearray()
                while True:
                    r, _, _ = select.select([fd], [], [], 5.0)
                    if not r:
                        raise OSError("keine Audio-Daten (Timeout)")
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        raise OSError("Level-Stream beendet")
                    buf += chunk
                    while len(buf) >= n * 2:
                        raw = bytes(buf[:n * 2])
                        del buf[:n * 2]
                        samples = struct.unpack("<%dh" % n, raw)
                        acc = 0
                        for v in samples:
                            acc += v * v
                        rms = math.sqrt(acc / n) / 32768.0
                        dbfs = (20.0 * math.log10(rms)
                                if rms > 0 else -90.0)
                        with self._lock:
                            self._smooth = (
                                dbfs if self._smooth is None
                                else 0.7 * self._smooth + 0.3 * dbfs)
                            if self._peak is None or dbfs > self._peak:
                                self._peak = dbfs
                            self.data = {
                                "dbfs": round(self._smooth, 1),
                                "db_spl": round(self._smooth + LEVEL_SPL_OFFSET),
                                "peak_dbfs": (round(self._peak, 1)
                                               if self._peak is not None
                                               else None),
                                "error": None,
                            }
                        m_sound_dbfs.set(self.data["dbfs"])
                        m_sound_spl.set(self.data["db_spl"])
                        m_sound_peak.set(self.data["peak_dbfs"])
            except Exception as exc:  # noqa: BLE001 — Messung darf nie crashen
                with self._lock:
                    self.data = {"dbfs": None, "db_spl": None,
                                 "peak_dbfs": (round(self._peak, 1)
                                               if self._peak is not None
                                               else None),
                                 "error": str(exc)}
                if proc is not None:
                    try:
                        proc.kill()
                    except Exception:
                        pass
                time.sleep(2)  # reconnect

    def snapshot(self):
        with self._lock:
            return dict(self.data)


# ----------------------------------------------- Mikrofon-Empfindlichkeit
class MicControl(threading.Thread):
    """Mikrofon-Empfindlichkeit am INMP441 einstellen und beobachten.

    Der Sollwert ist das Node-Volume des soc_sound-Quellenknotens in der
    PipeWire-Session des Users intercom (wpctl-Skala, kubisch: linear
    = v^3). Der Daemon laeuft als root und ruft wpctl per runuser in der
    Session auf. Aenderungen wirken live auf den AEC-Eingang und den
    Uplink (intercom-audio-tx).

    Persistenz: Der Wert wird in MIC_VOLUME_FILE gespeichert und beim
    naechsten Session-Start von set-speaker-volume.service wieder gesetzt.
    Ein Hintergrund-Thread haelt Cache und Prometheus-Metrik aktuell.
    """

    REFRESH = 15.0  # s
    CACHE_AGE = 10.0  # s: gueltiges Alter des Snapshot-Caches

    def __init__(self):
        super().__init__(daemon=True, name="mic-ctl")
        self._lock = threading.Lock()
        self._node_id = None
        self._cache = {"volume": None, "node": None, "live": False,
                       "error": "kein Abruf"}
        self._cache_ts = 0.0

    # ---- Hilfsmittel ------------------------------------------------
    def _session_cmd(self, prog, args):
        """Kommando in der PipeWire-Session des intercom-Users bauen."""
        runuser = shutil.which("runuser") or "/usr/sbin/runuser"
        return [runuser, "-u", MIC_USER, "--", "env",
                "XDG_RUNTIME_DIR=/run/user/%d" % MIC_UID,
                "HOME=" + MIC_HOME, prog] + list(args)

    def _wpctl(self, *args):
        """wpctl in der intercom-Session ausfuehren -> (rc, kombinierte
        Ausgabe)."""
        try:
            r = subprocess.run(self._session_cmd("wpctl", list(args)),
                               capture_output=True, text=True, timeout=10)
            return r.returncode, (r.stdout or "") + (r.stderr or "")
        except Exception as exc:  # noqa: BLE001
            return 127, str(exc)

    def _discover(self):
        """Node-ID des Mikrofons suchen (IDs wechseln zwischen Restarts).

        Gleiche Logik wie set-speaker-volume.sh: Quellen-Sektion des
        wpctl-status scannen und Kandidaten per wpctl inspect gegen den
        Node-Namen pruefen.
        """
        rc, out = self._wpctl("status")
        if rc != 0:
            return None
        in_sources = False
        for line in out.splitlines():
            if "Sources:" in line:
                in_sources = True
                continue
            if in_sources and ("Filters:" in line or "Sinks" in line):
                break
            if not in_sources:
                continue
            for m in re.finditer(r"(\d+)\.", line):
                node_id = m.group(1)
                rc2, out2 = self._wpctl("inspect", node_id)
                if rc2 == 0 and 'node.name = "%s"' % MIC_NODE in out2:
                    return node_id
        return None

    @staticmethod
    def _read_file():
        """Persistierten Sollwert lesen (letzter Wert aus der WebGUI)."""
        try:
            with open(MIC_VOLUME_FILE, "r") as fh:
                return round(float(fh.read().strip()), 2)
        except Exception:
            return MIC_DEFAULT

    @staticmethod
    def _write_file(volume):
        """Sollwert atomar persistieren; Datei gehoert danach intercom."""
        tmp = MIC_VOLUME_FILE + ".tmp"
        with open(tmp, "w") as fh:
            fh.write("%.2f\n" % volume)
        os.replace(tmp, MIC_VOLUME_FILE)
        os.chmod(MIC_VOLUME_FILE, 0o644)
        try:
            pwent = pwd.getpwnam(MIC_USER)
            os.chown(MIC_VOLUME_FILE, pwent.pw_uid, pwent.pw_gid)
        except Exception:  # noqa: BLE001 — chown ist optional
            pass

    def _cache_update(self, data):
        with self._lock:
            self._cache = data
            self._cache_ts = time.time()

    # ---- Oeffentliche Schnittstelle ---------------------------------
    def read(self, force=False):
        """Aktuellen Volume lesen: live wenn moeglich, sonst Datei."""
        if not force:
            with self._lock:
                if (self._cache.get("live")
                        and time.time() - self._cache_ts <= self.CACHE_AGE):
                    return dict(self._cache)
        data = self._read_live()
        self._cache_update(data)
        return data

    def _read_live(self):
        node = self._node_id or self._discover()
        if not node:
            return {"volume": self._read_file(), "node": None, "live": False,
                    "error": "Mikrofon-Quelle nicht gefunden"}
        self._node_id = node
        rc, out = self._wpctl("get-volume", node)
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if m:
            return {"volume": round(float(m.group(1)), 2), "node": node,
                    "live": True, "error": None}
        self._node_id = None
        return {"volume": self._read_file(), "node": None, "live": False,
                "error": "Volume nicht lesbar"}

    def set(self, volume):
        """Volume setzen (wpctl-Skala, MIC_MIN..MIC_MAX) und persistieren."""
        try:
            volume = round(float(volume), 2)
        except (TypeError, ValueError):
            raise ValueError("volume muss eine Zahl sein")
        if not (MIC_MIN <= volume <= MIC_MAX):
            raise ValueError(
                "Volume muss zwischen %s und %s liegen"
                % (MIC_MIN, MIC_MAX))
        for attempt in (0, 1):
            if attempt:
                self._node_id = None  # Session evtl. neu gestartet
            node = self._node_id or self._discover()
            if not node:
                break
            self._node_id = node
            self._wpctl("set-volume", node, "%.2f" % volume)
            rc, out = self._wpctl("get-volume", node)
            m = re.search(r"Volume:\s*([\d.]+)", out)
            if m and abs(float(m.group(1)) - volume) < 0.01:
                self._write_file(volume)
                data = {"volume": volume, "node": node, "live": True,
                        "error": None}
                self._cache_update(data)
                return data
        # Quelle nicht erreichbar: zumindest fuer den naechsten Start
        # persistieren (set-speaker-volume.service setzt den Wert dann neu).
        self._write_file(volume)
        data = {"volume": volume, "node": None, "live": False,
                "error": "Quelle nicht erreichbar - nur gespeichert"}
        self._cache_update(data)
        return data

    # ---- Hintergrund-Thread -------------------------------------------
    def run(self):
        while True:
            try:
                data = self._read_live()
                if data.get("live") and data.get("volume") is not None:
                    m_mic_volume.set(data["volume"])
            except Exception as exc:  # noqa: BLE001 — darf nie crashen
                data = {"volume": None, "node": None, "live": False,
                        "error": str(exc)}
            self._cache_update(data)
            time.sleep(self.REFRESH)


def mic_db(volume):
    """Verstaerkung in dB relativ zu 1.0 (wpctl-Skala: linear = v^3)."""
    if volume is None or volume <= 0:
        return None
    return round(60.0 * math.log10(volume), 1)


# ------------------------------------------------- Ausgabe-Lautstaerke
class SpeakerControl(threading.Thread):
    """Lautstaerke der Tonausgabe (Innen-Lautsprecher) einstellen.

    Der Sollwert ist das Node-Volume der USB/Jieli-Senke in der
    PipeWire-Session des Users intercom (wpctl-Skala 0..1.0 = 0..100%).
    Aenderungen wirken live auf die App-Wiedergabe
    (aecsink -> aec.sink -> Lautsprecher).

    Persistenz: Der Wert wird in SPEAKER_VOLUME_FILE gespeichert und beim
    naechsten Session-Start von set-speaker-volume.service wieder gesetzt.
    Ein Hintergrund-Thread haelt Cache und Prometheus-Metrik aktuell.
    """

    REFRESH = 15.0  # s
    CACHE_AGE = 10.0  # s

    def __init__(self):
        super().__init__(daemon=True, name="speaker-ctl")
        self._lock = threading.Lock()
        self._node_id = None
        self._cache = {"volume": None, "node": None, "live": False,
                       "error": "kein Abruf"}
        self._cache_ts = 0.0

    def _session_cmd(self, prog, args):
        runuser = shutil.which("runuser") or "/usr/sbin/runuser"
        return [runuser, "-u", SPEAKER_USER, "--", "env",
                "XDG_RUNTIME_DIR=/run/user/%d" % SPEAKER_UID,
                "HOME=" + SPEAKER_HOME, prog] + list(args)

    def _wpctl(self, *args):
        try:
            r = subprocess.run(self._session_cmd("wpctl", list(args)),
                               capture_output=True, text=True, timeout=10)
            return r.returncode, (r.stdout or "") + (r.stderr or "")
        except Exception as exc:  # noqa: BLE001
            return 127, str(exc)

    def _discover(self):
        """Node-ID der Senke suchen (Sinks-Sektion, IDs wechseln)."""
        rc, out = self._wpctl("status")
        if rc != 0:
            return None
        in_sinks = False
        for line in out.splitlines():
            if "Sinks:" in line:
                in_sinks = True
                continue
            if in_sinks and ("Sources:" in line or "Filters:" in line):
                break
            if not in_sinks:
                continue
            for m in re.finditer(r"(\d+)\.", line):
                node_id = m.group(1)
                rc2, out2 = self._wpctl("inspect", node_id)
                if rc2 == 0 and 'node.name = "%s"' % SPEAKER_NODE in out2:
                    return node_id
        return None

    @staticmethod
    def _read_file():
        try:
            with open(SPEAKER_VOLUME_FILE, "r") as fh:
                return round(float(fh.read().strip()), 2)
        except Exception:
            return SPEAKER_DEFAULT

    @staticmethod
    def _write_file(volume):
        tmp = SPEAKER_VOLUME_FILE + ".tmp"
        with open(tmp, "w") as fh:
            fh.write("%.2f\n" % volume)
        os.replace(tmp, SPEAKER_VOLUME_FILE)
        os.chmod(SPEAKER_VOLUME_FILE, 0o644)
        try:
            pwent = pwd.getpwnam(SPEAKER_USER)
            os.chown(SPEAKER_VOLUME_FILE, pwent.pw_uid, pwent.pw_gid)
        except Exception:  # noqa: BLE001
            pass

    def _cache_update(self, data):
        with self._lock:
            self._cache = data
            self._cache_ts = time.time()

    def read(self, force=False):
        if not force:
            with self._lock:
                if (self._cache.get("live")
                        and time.time() - self._cache_ts <= self.CACHE_AGE):
                    return dict(self._cache)
        data = self._read_live()
        self._cache_update(data)
        return data

    def _read_live(self):
        node = self._node_id or self._discover()
        if not node:
            return {"volume": self._read_file(), "node": None, "live": False,
                    "error": "Lautsprecher-Senke nicht gefunden"}
        self._node_id = node
        rc, out = self._wpctl("get-volume", node)
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if m:
            return {"volume": round(float(m.group(1)), 2), "node": node,
                    "live": True, "error": None}
        self._node_id = None
        return {"volume": self._read_file(), "node": None, "live": False,
                "error": "Volume nicht lesbar"}

    def set(self, volume):
        """Volume setzen (wpctl-Skala, SPEAKER_MIN..SPEAKER_MAX)."""
        try:
            volume = round(float(volume), 2)
        except (TypeError, ValueError):
            raise ValueError("volume muss eine Zahl sein")
        if not (SPEAKER_MIN <= volume <= SPEAKER_MAX):
            raise ValueError(
                "Volume muss zwischen %s und %s liegen"
                % (SPEAKER_MIN, SPEAKER_MAX))
        for attempt in (0, 1):
            if attempt:
                self._node_id = None
            node = self._node_id or self._discover()
            if not node:
                break
            self._node_id = node
            self._wpctl("set-volume", node, "%.2f" % volume)
            rc, out = self._wpctl("get-volume", node)
            m = re.search(r"Volume:\s*([\d.]+)", out)
            if m and abs(float(m.group(1)) - volume) < 0.01:
                self._write_file(volume)
                data = {"volume": volume, "node": node, "live": True,
                        "error": None}
                self._cache_update(data)
                return data
        self._write_file(volume)
        data = {"volume": volume, "node": None, "live": False,
                "error": "Quelle nicht erreichbar - nur gespeichert"}
        self._cache_update(data)
        return data

    def run(self):
        while True:
            try:
                data = self._read_live()
                if data.get("live") and data.get("volume") is not None:
                    m_speaker_volume.set(data["volume"])
            except Exception as exc:  # noqa: BLE001
                data = {"volume": None, "node": None, "live": False,
                        "error": str(exc)}
            self._cache_update(data)
            time.sleep(self.REFRESH)


