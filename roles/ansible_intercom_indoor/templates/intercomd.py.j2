MIC_USER = "{{ intercom_pipewire_user }}"
MIC_UID = {{ intercom_pipewire_uid }}
MIC_HOME = "{{ intercom_pipewire_user_home }}"
MIC_VOLUME_FILE = "{{ intercom_mic_volume_file }}"
MIC_DEFAULT = {{ intercom_mic_volume | float }}
MIC_MAX = {{ intercom_mic_volume_max | float }}
MIC_MIN = 0.0

# Lautstaerke der Tonausgabe (Innen-Lautsprecher): Sink-Volume der
# USB/Jieli-Senke in der PipeWire-Session (wpctl-Skala 0..1.0 = 0..100%).
SPEAKER_ENABLED = True
SPEAKER_NODE = "{{ intercom_pipewire_speaker_node }}"
SPEAKER_USER = "{{ intercom_pipewire_user }}"
SPEAKER_UID = {{ intercom_pipewire_uid }}
SPEAKER_HOME = "{{ intercom_pipewire_user_home }}"
SPEAKER_VOLUME_FILE = "{{ intercom_speaker_volume_file }}"
SPEAKER_DEFAULT = {{ intercom_speaker_volume | float }}
SPEAKER_MAX = {{ intercom_speaker_volume_max | float }}
SPEAKER_MIN = 0.0

state = {"call": "idle", "ts": 0}
# Letzter Status-Report der Qt-App (POST /state, Felder als Teilmenge).
app_state = {"hear": None, "speak": None, "volume": None,
             "video_restarts": None, "audio_restarts": None,
             "app_uptime_s": None, "ts": 0}
mqtt_connected = False
lock = threading.Lock()
