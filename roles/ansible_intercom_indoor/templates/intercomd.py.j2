class Handler(BaseHTTPRequestHandler):
    def _forwarded_ip(self):
        """Echte Client-IP, wenn die Anfrage via traefik0 kam, sonst None.

        intercomd lauscht nur auf 127.0.0.1: Direkte Anfragen ohne
        Forward-Header stammen von der Qt-App auf diesem Geraet.
        """
        ip = self.headers.get("X-Real-Ip")
        if not ip:
            ip = (self.headers.get("X-Forwarded-For", "")
                  .split(",")[0].strip())
        return ip or None

    def _send(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_metrics(self):
        update_metrics()
        body = generate_latest()
        self.send_response(200)
        self.send_header("Content-Type", CONTENT_TYPE_LATEST)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == "/metrics":
            self._send_metrics()
        elif path == "/api/status":
            self._send(200, status_snapshot())
        elif path == "/api/events":
            limit = 100
            try:
                limit = max(1, min(int(parse_qs(parsed.query)
                                      .get("limit", ["100"])[0]), EVENT_BUFFER))
            except (ValueError, IndexError):
                pass
            with events_lock:
                items = list(door_events)
            items.reverse()
            self._send(200, {"count": len(items), "since": STARTED_AT,
                             "events": items[:limit]})
        elif path == "/api/level":
            if LEVEL:
                self._send(200, LEVEL.snapshot())
            else:
                self._send(200, {"dbfs": None, "db_spl": None,
                                 "peak_dbfs": None,
                                 "error": "Pegelmesser deaktiviert"})
        elif path == "/api/mic":
            if not MIC:
                self._send(200, {"volume": None, "db_gain": None,
                                 "node": None, "live": False,
                                 "default": MIC_DEFAULT,
                                 "error": "Mikrofon-Steuerung deaktiviert"})
            else:
                data = MIC.read()
                data["db_gain"] = mic_db(data.get("volume"))
                data["default"] = MIC_DEFAULT
                self._send(200, data)
        elif path == "/api/speaker":
            if not SPEAKER:
                self._send(200, {"volume": None, "percent": None, "node": None,
                                 "live": False, "default": SPEAKER_DEFAULT,
                                 "error": "Lautsprecher-Steuerung deaktiviert"})
            else:
                data = SPEAKER.read()
                data["percent"] = (int(round(data["volume"] * 100))
                                   if data.get("volume") is not None else None)
                data["default"] = SPEAKER_DEFAULT
                self._send(200, data)
        elif path == "/state" and self._forwarded_ip() is None:
            # Nur die App auf diesem Geraet (500-ms-Polling).
            with lock:
                out = dict(state)
                out["app"] = dict(app_state)
            self._send(200, out)
        elif path == "/":
            self._send_gui()
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == "/state":
            if self._forwarded_ip() is not None:
                # Call-State-Steuerung bleibt der App vorbehalten; ueber
                # traefik0 (X-Real-Ip gesetzt) wird der Zugriff abgelehnt.
                self._send(403, {"error": "POST /state nur lokal"})
                return
            length = int(self.headers.get("Content-Length", "0"))
            try:
                payload = json.loads(self.rfile.read(length).decode())
                if not isinstance(payload, dict):
                    raise ValueError
            except Exception:
                self._send(400, {"error": "invalid payload"})
                return
            new_call = payload.get("call")
            speak = bool(payload.get("speak", False))
            if new_call is not None and new_call not in ("idle", "active", "ringing"):
                self._send(400, {"error": "invalid call"})
                return
            with lock:
                if new_call is not None:
                    state["call"] = new_call
                    state["ts"] = int(time.time())
                    cancel_ring_timer()
                    if new_call == "ringing":
                        schedule_ring_timeout()
                    set_tx(new_call == "active" and speak)
                    led_stop.set()
                    if led:
                        led.off()
                app_reported = False
                for field in APP_FIELDS:
                    if field in payload:
                        v = _app_field(field, payload[field])
                        if v is not None:
                            app_state[field] = v
                            app_reported = True
                if app_reported:
                    app_state["ts"] = time.time()
                out = dict(state)
                out["app"] = dict(app_state)
            publish_state()
            self._send(200, out)
        elif path == "/api/app/restart":
            # Wartungsaktion der WebGUI: Qt-App per systemd neu starten.
            try:
                r = subprocess.run(["systemctl", "restart", APP_SERVICE],
                                   timeout=30)
                ok = (r.returncode == 0)
                self._send(200, {"ok": ok})
            except Exception as exc:
                self._send(500, {"ok": False, "error": str(exc)})
        elif path == "/api/mic":
            # Mikrofon-Empfindlichkeit setzen (Body: {"volume": 2.0}).
            if not MIC:
                self._send(503, {"ok": False,
                                 "error": "Mikrofon-Steuerung deaktiviert"})
                return
            length = int(self.headers.get("Content-Length", "0"))
            try:
                payload = json.loads(self.rfile.read(length).decode())
                volume = payload.get("volume")
            except Exception:
                self._send(400, {"ok": False, "error": "invalid payload"})
                return
            try:
                result = MIC.set(volume)
            except ValueError as exc:
                self._send(400, {"ok": False, "error": str(exc)})
                return
            result["ok"] = bool(result.get("live"))
            result["db_gain"] = mic_db(result.get("volume"))
            if result.get("volume") is not None:
                m_mic_volume.set(result["volume"])
            self._send(200, result)
        elif path == "/api/speaker":
            # Lautstaerke der Tonausgabe setzen (Body: {"volume": 0.8}).
            if not SPEAKER:
                self._send(503, {"ok": False,
                                 "error": "Lautsprecher-Steuerung deaktiviert"})
                return
            length = int(self.headers.get("Content-Length", "0"))
            try:
                payload = json.loads(self.rfile.read(length).decode())
                volume = payload.get("volume")
            except Exception:
                self._send(400, {"ok": False, "error": "invalid payload"})
                return
            try:
                result = SPEAKER.set(volume)
            except ValueError as exc:
                self._send(400, {"ok": False, "error": str(exc)})
                return
            result["ok"] = bool(result.get("live"))
            if result.get("volume") is not None:
                result["percent"] = int(round(result["volume"] * 100))
                m_speaker_volume.set(result["volume"])
            self._send(200, result)
        else:
            self._send(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        pass

    def _send_gui(self):
        body = GUI_HTML.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


