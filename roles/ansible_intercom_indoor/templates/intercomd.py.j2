let status = null;

function fmtTime(iso) {
  if (!iso) return '\u2013';
  return new Date(iso).toLocaleString('de-DE');
}

function card(label, value, sub, cls) {
  return '<div class="card"><div class="label">' + label + '</div>' +
    '<div class="value ' + (cls || '') + '">' + value + '</div>' +
    '<div class="sub">' + (sub || '') + '</div></div>';
}

function render() {
  if (!status) return;
  const a = status.app || {};
  document.getElementById('restart-meta').textContent =
    'Neustart: ' + fmtTime(status.started_at) +
    ' (' + Math.round(status.uptime_s / 60) + ' min)';
  let html = '';
  html += card('Anruf', status.call === 'ringing' ? 'klingelt' :
                      (status.call === 'active' ? 'aktiv' : 'ruhend'),
               'Signalisierung',
               status.call === 'ringing' ? 'err' :
                 (status.call === 'active' ? 'ok' : ''));
  html += card('Qt-App', status.services.app ? 'l\u00e4uft' : 'aus',
               'systemd: intercom-app',
               status.services.app ? 'ok' : 'err');
  html += card('Lautst\u00e4rke',
               a.volume !== null && a.volume !== undefined
                 ? a.volume + ' %' : '\u2013',
               'Eingestellt am Touchscreen');
  const age = a.ts ? Math.round(Date.now() / 1000 - a.ts) : null;
  html += card('App-Bericht', age !== null ? age + ' s' : '\u2013',
               'Letzter Status-Report');
  html += card('Audio-TX', status.services.audio_tx ? 'aktiv' : 'aus',
               'Uplink zur T\u00fcr', status.services.audio_tx ? 'ok' : '');
  html += card('MQTT', status.mqtt.connected ? 'verbunden' : 'getrennt',
               status.mqtt.broker, status.mqtt.connected ? 'ok' : 'err');
  html += card('Uptime', Math.round(status.uptime_s / 60) + ' min',
               'Daemon seit ' + fmtTime(status.started_at));
  if (a.app_uptime_s !== null && a.app_uptime_s !== undefined) {
    html += card('App-Laufzeit', Math.round(a.app_uptime_s / 60) + ' min',
                 'Qt-App seit Start');
  }
  html += '<div class="card wide">' +
    '<div class="label">Schallpegel (Innen-Mikrofon)</div>' +
    '<div class="meter" id="meter"></div>' +
    '<div class="sub" id="level-value">wird gemessen &hellip;</div>' +
    '</div>';
  document.getElementById('cards').innerHTML = html;
}

function renderEvents(data) {
  const tb = document.querySelector('#tbl-events tbody');
  tb.innerHTML = (data.events || []).map(e =>
    '<tr><td>' + fmtTime(e.time) + '</td><td>' +
    (e.event === 'ring' ? 'Klingeln' :
     e.event === 'hangup' ? 'Aufgelegt' :
     e.event === 'ring_timeout' ? 'Klingel-Timeout' : e.event) +
    '</td></tr>').join('') ||
    '<tr><td colspan="2" class="dim">keine Ereignisse</td></tr>';
}

