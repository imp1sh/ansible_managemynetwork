[Unit]
Description=Intercom audio sender (INMP441 -> Opus RTP, AEC-gefiltert)
After=network-online.target
Wants=network-online.target

[Service]
# Wrapper-Skript mit Stille-Waechter: prueft aecsrc regelmaessig und
# verbindet bei digital-stillem Capture automatisch neu (Details im
# Skript-Kopf). XDG_RUNTIME_DIR setzt das Skript selbst (System-Services
# erhalten es nicht automatisch).
User={{ intercom_pipewire_user }}
Group={{ intercom_pipewire_user }}
ExecStart=/usr/bin/python3 /opt/intercom/intercom-audio-tx.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
