#!/bin/bash
# WireGuard endpoint DNS watcher
# Resolves the endpoint hostname, compares to the current wg endpoint,
# and updates it directly via wg set when the IP changed.
# No interface restart, no tunnel flap.
# Called by wg-endpoint-watch-<iface>.service on a timer.

set -eu

IFACE="{{ item.iface }}"
ENDPOINT="{{ item.endpoint }}"
HOSTNAME="{{ item.endpoint | split(':') | first }}"
PORT="{{ item.endpoint | split(':') | last }}"

# Resolve current DNS for the endpoint hostname
NEW_IP=$(getent ahosts "$HOSTNAME" | awk '{print $1}' | head -1)

if [ -z "$NEW_IP" ]; then
    echo "Failed to resolve $HOSTNAME, skipping"
    exit 0
fi

# Get current endpoint from wg show
# Output format: <pubkey>\t[<ipv6>]:<port>  OR  <pubkey>\t<ipv4>:<port>
RAW_EP=$(wg show "$IFACE" endpoints 2>/dev/null | awk '{print $2}')

if [ -z "$RAW_EP" ]; then
    echo "No current endpoint for $IFACE, setting to $NEW_IP:$PORT"
    PEER_KEY=$(wg show "$IFACE" peers 2>/dev/null | head -1)
    if [ -n "$PEER_KEY" ]; then
        wg set "$IFACE" peer "$PEER_KEY" endpoint "[$NEW_IP]:$PORT"
        echo "Set endpoint for $IFACE to [$NEW_IP]:$PORT"
    else
        echo "No peer found for $IFACE, cannot set endpoint"
        exit 1
    fi
    exit 0
fi

# Extract IP from endpoint. IPv6 is bracketed [addr]:port, IPv4 is addr:port
if [[ "$RAW_EP" == \[* ]]; then
    # IPv6: [2001:db8::1]:51820
    CURRENT_IP=$(echo "$RAW_EP" | sed 's/^\[//;s/\].*$//')
else
    # IPv4: 1.2.3.4:51820
    CURRENT_IP=$(echo "$RAW_EP" | rev | cut -d: -f2- | rev)
fi

if [ "$NEW_IP" != "$CURRENT_IP" ]; then
    echo "Endpoint changed: $CURRENT_IP -> $NEW_IP, updating $IFACE"
    PEER_KEY=$(wg show "$IFACE" peers 2>/dev/null | head -1)
    if [ -n "$PEER_KEY" ]; then
        wg set "$IFACE" peer "$PEER_KEY" endpoint "[$NEW_IP]:$PORT"
        echo "Updated endpoint for $IFACE to [$NEW_IP]:$PORT"
    else
        echo "No peer found for $IFACE, cannot update endpoint"
        exit 1
    fi
else
    echo "Endpoint unchanged ($CURRENT_IP), no action"
fi
