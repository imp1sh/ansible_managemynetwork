<?xml version="1.1" encoding="UTF-8"?>

<channel name="thunar" version="1.0">
{% for prop, opts in thunar_settings.items() %}
  <property name="{{ prop }}" type="{{ opts.type }}" value="{% if opts.type == 'bool' %}{% if opts.value %}true{% else %}false{% endif %}{% elif opts.type == 'int' %}{{ opts.value }}{% else %}{{ opts.value }}{% endif %}"/>
{% endfor %}
</channel>
