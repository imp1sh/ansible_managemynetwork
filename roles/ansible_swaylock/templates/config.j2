# swaylock configuration — generated by Ansible

# Background image and scaling
image={{ swaylock_effective_config.image }}
scaling={{ swaylock_effective_config.scaling }}
{% if swaylock_effective_config.color is defined -%}
color={{ swaylock_effective_config.color }}
{% endif %}

