{% endif %}
{% if swaylock_effective_config.ring_clear_color is defined -%}
ring-clear-color={{ swaylock_effective_config.ring_clear_color }}
{% endif %}
{% if swaylock_effective_config.text_ver_color is defined -%}
text-ver-color={{ swaylock_effective_config.text_ver_color }}
