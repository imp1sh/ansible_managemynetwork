{% endif %}
{% if swaylock_effective_config.font_size is defined -%}
font-size={{ swaylock_effective_config.font_size }}
{% endif %}

# Indicator geometry
indicator-radius={{ swaylock_effective_config.indicator_radius }}
indicator-thickness={{ swaylock_effective_config.indicator_thickness }}
{% if swaylock_effective_config.indicator_x_position is defined -%}
indicator-x-position={{ swaylock_effective_config.indicator_x_position }}
{% endif %}
{% if swaylock_effective_config.indicator_y_position is defined -%}
indicator-y-position={{ swaylock_effective_config.indicator_y_position }}
{% endif %}

# Boolean flags
{% if swaylock_effective_config.ignore_empty -%}
ignore-empty-password
{% endif %}
{% if swaylock_effective_config.indicator_idle_visible -%}
indicator-idle-visible
{% endif %}
{% if swaylock_effective_config.no_unlock_indicator -%}
no-unlock-indicator
{% endif %}
{% if swaylock_effective_config.show_keyboard_layout is defined and swaylock_effective_config.show_keyboard_layout -%}
show-keyboard-layout
{% endif %}
{% if swaylock_effective_config.hide_keyboard_layout is defined and swaylock_effective_config.hide_keyboard_layout -%}
hide-keyboard-layout
{% endif %}
{% if swaylock_effective_config.show_failed_attempts is defined and swaylock_effective_config.show_failed_attempts -%}
show-failed-attempts
{% endif %}
{% if swaylock_effective_config.disable_caps_lock_text is defined and swaylock_effective_config.disable_caps_lock_text -%}
disable-caps-lock-text
{% endif %}
{% if swaylock_effective_config.indicator_caps_lock is defined and swaylock_effective_config.indicator_caps_lock -%}
indicator-caps-lock
{% endif %}
{% if swaylock_effective_config.line_uses_inside is defined and swaylock_effective_config.line_uses_inside -%}
line-uses-inside
{% endif %}
{% if swaylock_effective_config.line_uses_ring is defined and swaylock_effective_config.line_uses_ring -%}
