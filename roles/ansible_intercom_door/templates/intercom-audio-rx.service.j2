[Unit]
Description=Intercom audio receiver (Opus RTP -> Klinke)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/gst-launch-1.0 -e udpsrc address=:: port={{ intercom_audio_rx_port }} caps=application/x-rtp,media=audio,encoding-name=OPUS,payload=96,clock-rate=48000 ! queue max-size-buffers=0 max-size-bytes=0 max-size-time=100000000 leaky=downstream ! rtpopusdepay ! opusdec ! audioconvert ! audioresample ! alsasink device=plughw:CARD=Headphones,DEV=0 sync=false buffer-time=80000 latency-time=20000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
