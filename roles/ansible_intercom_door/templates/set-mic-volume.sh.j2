#!/bin/sh
# Mikrofon-Empfindlichkeit (INMP441 via soc_sound) in der PipeWire-Session
# setzen. Laeuft als User-Service in der intercom-Session (linger) nach
# jedem PipeWire-/WirePlumber-(Re)Start, weil Nodes dabei ihr Volume
# verlieren.
# Quelle des Soll-Werts (Reihenfolge):
#   1. /var/lib/intercom/mic_volume  — letzte Einstellung aus der WebGUI
#   2. intercom_mic_volume (Ansible-Default, gerendert unten)
# wpctl-Skala ist kubisch (linear = v^3): 3.0 = 27-fach = +28.6 dB.
# Managed by Ansible (role ansible_intercom_door) - do not edit by hand.
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export HOME={{ intercom_pipewire_user_home }}

VOLUME="$(cat {{ intercom_mic_volume_file }} 2>/dev/null || true)"
[ -n "$VOLUME" ] || VOLUME="{{ intercom_mic_volume }}"
MIC_NODE="{{ intercom_pipewire_mic_node }}"

# Nach dem Boot dauert die Knoten-Registrierung einen Moment -> retry.
try=0
while [ "$try" -lt 15 ]; do
    for id in $(wpctl status 2>/dev/null | sed -n '/Sources:/,/Filters:/p' | grep -oE '[0-9]+\.' | tr -d '.'); do
        if wpctl inspect "$id" 2>/dev/null | grep -q "node.name = \"${MIC_NODE}\""; then
            wpctl set-volume "$id" "$VOLUME"
            echo "intercom: Mikrofon-Volume ${VOLUME} gesetzt (Node ${id}, ${MIC_NODE})"
            exit 0
        fi
    done
    try=$((try + 1))
    sleep 2
done
echo "intercom: WARNUNG - Mikrofon-Quelle ${MIC_NODE} nicht gefunden, Volume nicht gesetzt" >&2
exit 0
