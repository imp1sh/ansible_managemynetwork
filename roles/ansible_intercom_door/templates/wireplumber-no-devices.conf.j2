# rpicam-vid (intercom-cam) benutzt. Ohne diese Overlays wuerde WirePlumber
# /dev/video0 belegen.
wireplumber.components = [
  {
    type = virtual, provides = monitor.libcamera
  }
  {
    type = virtual, provides = monitor.v4l2
  }
]
