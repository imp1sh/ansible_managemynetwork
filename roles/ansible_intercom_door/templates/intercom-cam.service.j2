[Unit]
Description=Intercom camera (CSI/libcamera -> RTSP-Push an go2rtc)
After=network-online.target go2rtc0.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# rpicam-vid kodiert per Hardware (H264, Inline-Header) und piped nach ffmpeg,
# das nur remuxt und per RTSP an go2rtc pusht (Stream-Quelle dort: leer).
ExecStart=/bin/sh -c 'exec /usr/bin/rpicam-vid -t 0 --camera {{ intercom_cam_device }} --width {{ intercom_cam_width }} --height {{ intercom_cam_height }} --framerate {{ intercom_cam_framerate }} --codec h264 --inline --bitrate {{ intercom_cam_bitrate }}{% if intercom_cam_hflip %} --hflip{% endif %}{% if intercom_cam_vflip %} --vflip{% endif %}{% if intercom_cam_extra_args %} {{ intercom_cam_extra_args }}{% endif %} -o - | exec /usr/bin/ffmpeg -hide_banner -loglevel warning -nostdin -fflags nobuffer -f h264 -i -{% if intercom_cam_audio %} -f alsa -i {{ intercom_cam_audio_card }}{% endif %} -map 0:v{% if intercom_cam_audio %} -map 1:a{% endif %} -c:v copy{% if intercom_cam_audio %} -c:a libopus -b:a {{ intercom_cam_audio_bitrate }} -ar 48000 -ac 1 -application {{ intercom_cam_audio_application }} -frame_duration {{ intercom_cam_audio_frame_duration }} -af aresample=async=1:first_pts=0{% endif %} -rtsp_transport tcp -f rtsp rtsp://127.0.0.1:{{ intercom_mediamtx_rtsp_port }}/{{ intercom_mediamtx_path }}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
