[Unit]
Description=Intercom camera (CSI/libcamera -> RTSP-Push an go2rtc)
After=network-online.target go2rtc0.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# rpicam-vid kodiert per Hardware (H264, Inline-Header) und piped nach ffmpeg,
# das nur remuxt und per RTSP an go2rtc pusht (Stream-Quelle dort: leer).
ExecStart=/bin/sh -c 'exec /usr/bin/rpicam-vid -t 0 --camera {{ intercom_cam_device }} --width {{ intercom_cam_width }} --height {{ intercom_cam_height }} --framerate {{ intercom_cam_framerate }} --codec h264 --inline --bitrate {{ intercom_cam_bitrate }}{% if intercom_cam_hflip %} --hflip{% endif %}{% if intercom_cam_vflip %} --vflip{% endif %}{% if intercom_cam_extra_args %} {{ intercom_cam_extra_args }}{% endif %} -o - | exec /usr/bin/ffmpeg -hide_banner -loglevel warning -nostdin -fflags nobuffer -f h264 -i - -c:v copy -rtsp_transport tcp -f rtsp rtsp://127.0.0.1:{{ intercom_cam_rtsp_port }}/{{ intercom_cam_stream }}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
