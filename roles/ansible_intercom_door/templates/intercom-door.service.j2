[Unit]
Description=Intercom door daemon (button, relay, sensor, API, MQTT, metrics)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/intercom/intercom-door.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
