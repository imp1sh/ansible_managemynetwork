[Unit]
Description=Intercom camera audio (INMP441 via PipeWire rawmic -> mediamtx, nur Audio)
After=network-online.target pipewire.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ intercom_pipewire_user }}
Group={{ intercom_pipewire_user }}
# Nur EIN Input (ALSA/PipeWire rawmic) — kein Video-Pipe, der blockieren koennte.
# Das Video laeuft im separaten Dienst intercom-cam-video.
ExecStart=/bin/sh -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u); exec /usr/bin/ffmpeg -hide_banner -loglevel warning -nostdin -fflags nobuffer -use_wallclock_as_timestamps 1 -f alsa -i {{ intercom_cam_audio_card }} -c:a libopus -b:a {{ intercom_cam_audio_bitrate }} -ar 48000 -af "pan=mono|c0=c0,aresample=async=1:first_pts=0" -application {{ intercom_cam_audio_application }} -frame_duration {{ intercom_cam_audio_frame_duration }} -rtsp_transport tcp -f rtsp rtsp://127.0.0.1:{{ intercom_mediamtx_rtsp_port }}/{{ intercom_mediamtx_audio_path }}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
