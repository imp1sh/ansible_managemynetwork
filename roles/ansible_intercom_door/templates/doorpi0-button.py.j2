#!/usr/bin/env python3
# Managed by Ansible (role ansible_intercom_door).
# GPIO-Taster: kurzer Druck = 'ring'; waehrend aktivem Gespraech = 'hangup'.
# Bei 'ring' wird zusaetzlich der mechanische Gong (Honeywell D117) ueber
# ein Relais an GPIO24 fuer eine kurze Pulsdauer bestromt.
import json
import signal
import threading
import time

import paho.mqtt.client as mqtt
from gpiozero import Button, OutputDevice

BROKER = "{{ intercom_broker_host }}"
PORT = {{ intercom_broker_port }}
CA = "{{ intercom_ca_file }}"
USER = "{{ intercom_mqtt_username }}"
PASSWORD = "{{ intercom_mqtt_password }}"
LINE = {{ intercom_gpio_line }}
BOUNCE = {{ intercom_button_bounce }}
DEBOUNCE = {{ intercom_button_debounce }}

GONG_ENABLED = {{ 'True' if intercom_gong_enabled else 'False' }}
GONG_LINE = {{ intercom_gong_gpio }}
GONG_ACTIVE_HIGH = {{ 'True' if intercom_gong_active_high else 'False' }}
GONG_PULSE = {{ intercom_gong_pulse }}
GONG_ON_HANGUP = {{ 'True' if intercom_gong_on_hangup else 'False' }}

call_active = False
last_press = 0.0

# active_high=False: LOW zieht das Relais an, HIGH ist aus (active-low Modul).
gong = None
if GONG_ENABLED:
    gong = OutputDevice(GONG_LINE, active_high=GONG_ACTIVE_HIGH, initial_value=False)

gong_timer = None


def gong_off():
    global gong_timer
    gong_timer = None
    if gong is not None:
        gong.off()


def pulse_gong():
    """Relais fuer GONG_PULSE Sekunden anziehen; erneuter Druck verlaengert."""
    global gong_timer
    if gong is None:
        return
    if gong_timer is not None:
        gong_timer.cancel()
    gong.on()
    gong_timer = threading.Timer(GONG_PULSE, gong_off)
    gong_timer.daemon = True
    gong_timer.start()


def on_connect(client, userdata, flags, rc, properties=None):
    if rc == 0:
        client.publish("intercom/door/presence", "online", qos=1, retain=True)
        client.subscribe("intercom/indoor/+/state", qos=1)
        print("mqtt connected", flush=True)


def on_message(client, userdata, msg):
    global call_active
    try:
        payload = json.loads(msg.payload.decode())
    except Exception:
        return
    call_active = payload.get("call") == "active"


def on_press():
    global last_press
    now = time.time()
    if now - last_press < DEBOUNCE:
        return
    last_press = now
    event = "hangup" if call_active else "ring"
    # Lokaler Gong zuerst: funktioniert auch ohne MQTT-Verbindung.
    if event == "ring" or GONG_ON_HANGUP:
        pulse_gong()
    try:
        client.publish("intercom/door/event",
                       json.dumps({"event": event, "ts": int(now)}), qos=1)
        print(f"event published: {event}", flush=True)
    except Exception as exc:  # kein Broker -> Event verwerfen, kein Absturz
        print(f"event publish failed: {exc}", flush=True)


def shutdown(signum, frame):
    if gong_timer is not None:
        gong_timer.cancel()
    if gong is not None:
        gong.off()
    try:
        client.loop_stop()
        client.disconnect()
    except Exception:
        pass
    raise SystemExit(0)


client = mqtt.Client(client_id="doorpi0-button")
client.will_set("intercom/door/presence", "offline", qos=1, retain=True)
client.tls_set(ca_certs=CA)
client.username_pw_set(USER, PASSWORD)
client.on_connect = on_connect
client.on_message = on_message
# Verbindung ohne Absturz: connect_async baut die Verbindung im
# Netzwerk-Thread auf und wiederholt automatisch (DNS-/Netzstoerungen
# sind kein Crash). Der Dienst (und damit der lokale Gong) laeuft auch
# ohne Broker.
client.reconnect_delay_set(min_delay=1, max_delay=30)
client.connect_async(BROKER, PORT, keepalive=30)
client.loop_start()

button = Button(LINE, pull_up=True, bounce_time=BOUNCE)
button.when_pressed = on_press

signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)

try:
    signal.pause()
finally:
    if gong is not None:
        gong.off()
