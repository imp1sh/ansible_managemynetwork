SENSOR = Shtc3Sensor(SENSOR_BUS, SENSOR_ADDR, SENSOR_INTERVAL)
LEVEL = LevelMeter() if LEVEL_ENABLED else None
MIC = MicControl() if MIC_ENABLED else None


def main():
    atexit.register(gong.shutdown)
    mqtt_setup()
    gpio_setup()
    SENSOR.start()
    if LEVEL is not None:
        LEVEL.start()
    if MIC is not None:
        MIC.start()
    print("intercom-door gestartet: http://%s:%d (Neustart %s)"
          % (HTTP_HOST, HTTP_PORT, STARTED_AT), flush=True)
    uvicorn.run(api, host=HTTP_HOST, port=HTTP_PORT, log_level="warning")


if __name__ == "__main__":
    main()
