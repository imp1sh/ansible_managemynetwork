<script>
let status = null;

function fmtTime(iso) {
  if (!iso) return '\u2013';
  return new Date(iso).toLocaleString('de-DE');
}

function card(label, value, sub, cls) {
  return '<div class="card"><div class="label">' + label + '</div>' +
    '<div class="value ' + (cls || '') + '">' + value + '</div>' +
    '<div class="sub">' + (sub || '') + '</div></div>';
}

function render() {
  if (!status) return;
  const s = status.sensor || {};
  document.getElementById('restart-meta').textContent =
    'Neustart: ' + fmtTime(status.started_at) +
    ' (' + Math.round(status.uptime_s / 60) + ' min)';
  let html = '';
  html += card('Anruf', status.call_active ? 'aktiv' : 'ruhend',
               'Zustand der Innenger&auml;te');
  const lb = status.button.last_event;
  html += card('T&uuml;rknopf', lb ? lb.event : '\u2013',
               lb ? fmtTime(lb.time) + ' &middot; ' + lb.source : 'keine Bet&auml;tigung');
  const lr = status.relay.last_event;
  html += card('Gong-Relais', status.relay.state === 'on' ? 'an (Puls)' : 'aus',
               lr ? fmtTime(lr.time) + ' &middot; ' + lr.trigger +
                    (lr.success ? '' : ' &middot; Fehler') : 'keine Aktivit&auml;t',
               lr && !lr.success ? 'err' : 'ok');
  html += card('Temperatur',
               s.temperature_c !== null && s.temperature_c !== undefined
                 ? s.temperature_c + ' &deg;C' : '\u2013',
               s.error ? 'Sensor: ' + s.error : fmtTime(s.time));
  html += card('Rel. Feuchte',
               s.humidity_pct !== null && s.humidity_pct !== undefined
                 ? s.humidity_pct + ' %' : '\u2013',
               s.error ? 'Sensor: ' + s.error : fmtTime(s.time));
  html += card('MQTT', status.mqtt.connected ? 'verbunden' : 'getrennt',
               status.mqtt.broker, status.mqtt.connected ? 'ok' : 'err');
  html += '<div class="card wide">' +
