    '<td class="' + (e.pin_state_off ? 'ok' : 'dim') + '">' + (e.pin_state_off ? 'ok' : '\u2013') + '</td>' +
    '<td class="dim">' + (e.button_event_id !== null ? '#' + e.button_event_id : '\u2013') +
    '</td></tr>').join('') || '<tr><td colspan="7" class="dim">keine Aktivit&auml;ten</td></tr>';
}

async function refresh() {
  try {
    const r = await fetch('/api/status');
    status = await r.json();
    render();
    const ev = await (await fetch('/api/events?limit=50')).json();
    renderEvents(ev);
    const f = await (await fetch('/metrics')).text();
    document.getElementById('footer').textContent =
      'intercom-door ' + status.version + ' &middot; Prometheus-Exporter: /metrics';
  } catch (e) {
    document.getElementById('toast').textContent = 'Aktualisierung fehlgeschlagen';
  }
}

const SEG = 24, LEVEL_MIN = -60, LEVEL_MAX = 0;
function renderLevel(l) {
  const el = document.getElementById('meter');
  const val = document.getElementById('level-value');
  if (!el || !val) return;
  if (el.children.length !== SEG) {
    let h = '';
    for (let i = 0; i < SEG; i++) h += '<i></i>';
    el.innerHTML = h;
  }
  if (!l || l.dbfs === null || l.dbfs === undefined) {
    for (let i = 0; i < SEG; i++) el.children[i].className = '';
    val.textContent = l && l.error ? 'Fehler: ' + l.error : 'keine Messung';
    return;
  }
  const frac = Math.max(0, Math.min(1, (l.dbfs - LEVEL_MIN) / (LEVEL_MAX - LEVEL_MIN)));
  const lit = Math.round(frac * SEG);
  for (let i = 0; i < SEG; i++) {
    const segDb = LEVEL_MIN + (LEVEL_MAX - LEVEL_MIN) * (i + 1) / SEG;
    const on = i < lit;
    el.children[i].className = on ? (segDb > -8 ? 'on r' : (segDb > -18 ? 'on y' : 'on')) : '';
  }
  val.textContent = l.dbfs.toFixed(1) + ' dBFS \u00b7 ~' + Math.round(l.db_spl) + ' dB SPL' +
    (l.peak_dbfs !== null && l.peak_dbfs !== undefined ? ' \u00b7 Peak ' + l.peak_dbfs.toFixed(1) + ' dB' : '');
}

async function refreshLevel() {
  try {
    renderLevel(await (await fetch('/api/level')).json());
  } catch (e) {
    renderLevel(null);
  }
}

async function act(url, btn, label) {
  btn.disabled = true;
  document.getElementById('toast').textContent = '';
  try {
    const r = await fetch(url, {method: 'POST'});
    const j = await r.json();
    document.getElementById('toast').textContent =
      label + (j.ok ? ' OK' : ' fehlgeschlagen');
  } catch (e) {
    document.getElementById('toast').textContent = label + ' Fehler: ' + e;
  }
  btn.disabled = false;
  refresh();
}

function ring() { act('/api/button/press',
  document.getElementById('btn-ring'), 'Klingeln'); }
function gongTest() { act('/api/relay/pulse',
  document.getElementById('btn-gong'), 'Gong'); }

let micCur = null;
async function refreshMic() {
  try {
    const r = await fetch('/api/mic');
    micCur = await r.json();
    const slider = document.getElementById('mic-slider');
    const val = document.getElementById('mic-value');
    const db = document.getElementById('mic-db');
    if (micCur.volume !== null && micCur.volume !== undefined) {
      if (document.activeElement !== slider) slider.value = micCur.volume;
      val.textContent = micCur.volume.toFixed(1);
      db.textContent = micCur.db_gain === null ? 'stumm'
        : (micCur.db_gain >= 0 ? '+' : '') + micCur.db_gain.toFixed(1) +
          ' dB Verstaerkung';
    } else {
      val.textContent = '\u2013';
      db.textContent = micCur.error || 'nicht verf\u00fcgbar';
    }
  } catch (e) { /* naechster Refresh versucht es erneut */ }
}

async function micSet() {
  const btn = document.getElementById('btn-mic');
  const v = parseFloat(document.getElementById('mic-slider').value);
  if (isNaN(v)) return;
  btn.disabled = true;
  document.getElementById('toast').textContent = '';
  const body = JSON.stringify({volume: v});
  try {
    const r = await fetch('/api/mic',
      {method: 'POST', headers: {'Content-Type': 'application/json'}, body: body});
    const j = await r.json();
    document.getElementById('toast').textContent = j.ok
      ? 'Mikrofon: ' + j.volume.toFixed(1) + ' gesetzt'
      : 'Mikrofon: ' + (j.error || 'Fehler');
  } catch (e) {
    document.getElementById('toast').textContent = 'Mikrofon-Fehler: ' + e;
  }
  btn.disabled = false;
  refreshMic();
}

function micDefault() {
  document.getElementById('mic-slider').value = {{ intercom_mic_volume | float }};
  micSet();
}

refresh();
setInterval(refresh, 5000);
refreshLevel();
setInterval(refreshLevel, 1000);
refreshMic();
setInterval(refreshMic, 5000);
</script>
