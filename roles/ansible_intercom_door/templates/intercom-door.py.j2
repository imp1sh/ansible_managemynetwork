# ------------------------------------------------------------------ Zustand
call_active = False
mqtt_connected = False
last_press = 0.0

button_events = deque(maxlen=EVENT_BUFFER)
relay_events = deque(maxlen=EVENT_BUFFER)
_events_lock = threading.Lock()
_event_ids = itertools.count(1)

# ----------------------------------------------------------------- Metriken
m_button_presses = Counter(
    "intercom_door_button_presses", "Tasterbet betaetigungen", ["event", "source"])
m_relay_pulses = Counter(
    "intercom_door_relay_pulses", "Gong-Relais Impulse", ["source", "success"])
m_relay_failures = Counter(
    "intercom_door_relay_failures", "Fehlgeschlagene Relais-Impulse")
m_temperature = Gauge(
    "intercom_door_temperature_celsius", "SHTC3 Temperatur in Celsius")
m_humidity = Gauge(
    "intercom_door_humidity_percent", "SHTC3 relative Feuchte in Prozent")
m_sensor_age = Gauge(
    "intercom_door_sensor_age_seconds", "Alter der letzten Sensor-Messung")
m_sensor_up = Gauge(
    "intercom_door_sensor_up", "Sensor verfuegbar (1/0)")
m_call_active = Gauge(
    "intercom_door_call_active", "Gespraech aktiv (1/0)")
m_mqtt_connected = Gauge(
    "intercom_door_mqtt_connected", "MQTT verbunden (1/0)")


def now_iso():
    return datetime.now(tz=timezone.utc).astimezone().isoformat(timespec="seconds")


# --------------------------------------------------------------- SHTC3-Sensor
def crc8(data):
    crc = 0xFF
    for byte in data:
        crc ^= byte
        for _ in range(8):
            crc = ((crc << 1) ^ 0x31) & 0xFF if crc & 0x80 else (crc << 1) & 0xFF
    return crc


class Shtc3Sensor(threading.Thread):
    """Liest den SHTC3 zyklisch (Wakeup -> Messung -> Schlaf)."""

    def __init__(self, bus, addr, interval):
        super().__init__(daemon=True, name="shtc3")
        self.bus_path = bus
        self.addr = addr
        self.interval = interval
        self.data = {"temperature_c": None, "humidity_pct": None,
                     "ts": None, "time": None, "error": "keine Messung"}
        self._lock = threading.Lock()

    def _init_sensor(self):
        """Einmalige Initialisierung: wecken (NACK im Schlaf!), Reset, ID."""
        fd = os.open(self.bus_path, os.O_RDWR)
        try:
            fcntl.ioctl(fd, 0x0703, self.addr)

            def cmd(c):
                os.write(fd, bytes([c >> 8, c & 0xFF]))

            cmd(0x3517)  # Wakeup — im Schlafmodus NACKt der SHTC3 alles andere
            time.sleep(0.002)
            cmd(0x805D)  # Soft Reset
            time.sleep(0.002)
            cmd(0xEFC8)  # ID lesen
            time.sleep(0.002)
            raw = os.read(fd, 3)
            chip = struct.unpack(">H", raw[:2])[0] & 0x083F
            if chip != 0x807:
                raise OSError("SHTC3 nicht erkannt (ID 0x%03X)" % chip)
        finally:
            os.close(fd)

    def _read_once(self):
        fd = os.open(self.bus_path, os.O_RDWR)
        try:
            fcntl.ioctl(fd, 0x0703, self.addr)

            def cmd(c):
                os.write(fd, bytes([c >> 8, c & 0xFF]))

            # Wake zuerst, sonst EIO (NACK) im Schlafmodus.
            cmd(0x3517)  # Wakeup
            time.sleep(0.002)
            cmd(0x7866)  # Messung, T zuerst, ohne Clock Stretching
            time.sleep(0.015)
            data = os.read(fd, 6)
            if len(data) != 6:
                raise OSError("zu wenige Bytes: %d" % len(data))
            if crc8(data[0:2]) != data[2] or crc8(data[3:5]) != data[5]:
                raise OSError("CRC-Fehler")
            raw_t = struct.unpack(">H", data[0:2])[0]
            raw_h = struct.unpack(">H", data[3:5])[0]
            temp = (((4375 * raw_t) >> 14) - 4500) / 100.0
            hum = ((625 * raw_h) >> 12) / 100.0
            cmd(0xB098)  # Sleep
            return temp, hum
        finally:
            os.close(fd)

    def run(self):
        try:
            self._init_sensor()
            print("SHTC3 erkannt (ID 0x807)", flush=True)
        except Exception as exc:
            print("SHTC3 init fehlgeschlagen: %s" % exc, flush=True)
        while True:
            temp = hum = None
            error = None
            for _ in range(2):  # ein Retry faengt Einzelfehler ab
                try:
                    temp, hum = self._read_once()
                    error = None
                    break
                except Exception as exc:
                    error = str(exc)
                    time.sleep(0.2)
            if temp is not None:
                with self._lock:
                    self.data = {"temperature_c": round(temp, 2),
                                 "humidity_pct": round(hum, 1),
                                 "ts": time.time(), "time": now_iso(),
                                 "error": None}
                m_temperature.set(temp)
                m_humidity.set(hum)
                m_sensor_up.set(1)
            else:
                with self._lock:
                    self.data = {"temperature_c": None, "humidity_pct": None,
                                 "ts": time.time(), "time": now_iso(),
                                 "error": error}
                m_sensor_up.set(0)
            time.sleep(self.interval)

    def snapshot(self):
        with self._lock:
            data = dict(self.data)
        if data.get("ts"):
            m_sensor_age.set(max(0.0, time.time() - data["ts"]))
        return data


# ------------------------------------------------------------------ MQTT
client = None


def mqtt_publish(topic, payload, retain=False):
    if client is None:
        return
    try:
        client.publish(topic, json.dumps(payload), qos=1, retain=retain)
    except Exception as exc:  # noqa: BLE001 — MQTT darf nie crashen
        print("mqtt publish failed: %s" % exc, flush=True)


def on_connect(cl, userdata, flags, rc, properties=None):
    global mqtt_connected
    if rc == 0:
        mqtt_connected = True
        m_mqtt_connected.set(1)
        cl.publish(TOPIC_PRESENCE, "online", qos=1, retain=True)
        cl.subscribe("intercom/indoor/+/state", qos=1)
        print("mqtt connected", flush=True)
    else:
        mqtt_connected = False
        m_mqtt_connected.set(0)


def on_disconnect(cl, userdata, flags, rc, properties=None):
    global mqtt_connected
    mqtt_connected = False
    m_mqtt_connected.set(0)


def on_message(cl, userdata, msg):
    global call_active
    try:
        payload = json.loads(msg.payload.decode())
    except Exception:
        return
    call_active = payload.get("call") == "active"
    m_call_active.set(1 if call_active else 0)


def mqtt_setup():
    global client
    try:
        client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1,
                             client_id="intercom-door")
    except AttributeError:  # aeltere paho-Version
        client = mqtt.Client(client_id="intercom-door")
    client.will_set(TOPIC_PRESENCE, "offline", qos=1, retain=True)
    client.tls_set(ca_certs=CA)
    client.username_pw_set(USER, PASSWORD)
    client.on_connect = on_connect
    client.on_disconnect = on_disconnect
    client.on_message = on_message
    # Kein Crash bei DNS-/Netz-Fehlern: Verbindung im Netzwerk-Thread.
    client.reconnect_delay_set(min_delay=1, max_delay=30)
    client.connect_async(BROKER, PORT, keepalive=30)
    client.loop_start()


# ------------------------------------------------------------------ Events
def record_button_event(source, event, call):
    with _events_lock:
        entry = {
            "id": next(_event_ids),
            "ts": round(time.time(), 3),
            "time": now_iso(),
            "source": source,
            "event": event,
            "call": call,
            "relay_event_id": None,
        }
        button_events.append(entry)
    m_button_presses.labels(event=event, source=source).inc()
    return entry


def record_relay_event(source, trigger, button_event_id, success, pin_on):
    with _events_lock:
        entry = {
            "id": next(_event_ids),
            "ts": round(time.time(), 3),
            "time": now_iso(),
            "source": source,
            "trigger": trigger,
            "duration_s": GONG_PULSE,
            "success": success,
            "pin_state_on": pin_on,
            "pin_state_off": None,
            "button_event_id": button_event_id,
        }
        relay_events.append(entry)
    m_relay_pulses.labels(source=source,
                          success="1" if success else "0").inc()
    if not success:
        m_relay_failures.inc()
    mqtt_publish(TOPIC_RELAY, {
        "event": "activated" if success else "failed",
        "source": source,
        "trigger": trigger,
        "duration_s": GONG_PULSE,
        "success": success,
        "button_event_id": button_event_id,
        "ts": entry["ts"],
    })
    return entry


# ------------------------------------------------------------------ Gong
class Gong:
    """Gong-Relais mit Puls, Retrigger und Software-Feedback."""

    def __init__(self):
        self.dev = None
        self.timer = None
        self.lock = threading.Lock()
        if GONG_ENABLED:
            self.dev = OutputDevice(GONG_GPIO, active_high=GONG_ACTIVE_HIGH,
                                    initial_value=False)

    def _off(self, entry):
        with self.lock:
            self.timer = None
            if self.dev is None:
                return
            try:
                self.dev.off()
                ok = self.dev.value == 0.0
            except Exception:
                ok = False
            if entry is not None:
                entry["pin_state_off"] = ok

    def pulse(self, source, trigger, button_event_id):
        if self.dev is None:
            return None
        entry = None
        success = False
        pin_on = None
        try:
            with self.lock:
                if self.timer is not None:
                    self.timer.cancel()
                self.dev.on()
                pin_on = (self.dev.value == 1.0)
                success = pin_on
        except Exception as exc:
            print("gong pulse failed: %s" % exc, flush=True)
        entry = record_relay_event(source, trigger, button_event_id,
                                   success, pin_on)
        if success:
            with self.lock:
                self.timer = threading.Timer(GONG_PULSE, self._off, (entry,))
                self.timer.daemon = True
                self.timer.start()
        else:
            self._off(None)
        return entry

    def shutdown(self):
        with self.lock:
            if self.timer is not None:
                self.timer.cancel()
                self.timer = None
            if self.dev is not None:
                try:
                    self.dev.off()
                except Exception:
                    pass


gong = Gong()


# -------------------------------------------------------------- Klingel-Flow
def handle_press(source):
    """Physischer oder API-Tastendruck: Event, Gong, MQTT (legacy + neu)."""
    global last_press
    now = time.time()
    if source == "button":
        if now - last_press < PRESS_DEBOUNCE:
            return None
        last_press = now
    event = "hangup" if call_active else "ring"
    call = "active" if call_active else "idle"
    entry = record_button_event(source, event, call)
    if event == "ring" or GONG_ON_HANGUP:
        relay_entry = gong.pulse(source=source, trigger=event,
                                button_event_id=entry["id"])
        if relay_entry is not None:
            entry["relay_event_id"] = relay_entry["id"]
    mqtt_publish(TOPIC_LEGACY, {"event": event, "ts": int(now)})
    mqtt_publish(TOPIC_BUTTON, {
        "event": "press",
        "source": source,
        "result": event,
        "call": call,
        "relay_event_id": entry["relay_event_id"],
        "ts": entry["ts"],
    })
    return entry


button = None


def gpio_setup():
    global button
    button = Button(BUTTON_GPIO, pull_up=True, bounce_time=BUTTON_BOUNCE)
    button.when_pressed = lambda: handle_press("button")


# ------------------------------------------------------------------ API
api = FastAPI(title="intercom-door", version=APP_VERSION)


@api.get("/metrics")
def api_metrics():
    from fastapi.responses import Response
    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)


@api.get("/api/status")
def api_status():
    snap = SENSOR.snapshot() if SENSOR else {}
    with _events_lock:
        btn = list(button_events)
        rel = list(relay_events)
    last_btn = btn[-1] if btn else None
    last_rel = rel[-1] if rel else None
    return {
        "version": APP_VERSION,
        "started_at": STARTED_AT,
        "started_ts": STARTED_TS,
        "uptime_s": round(time.time() - STARTED_TS, 1),
        "button": {"gpio": BUTTON_GPIO,
                   "pressed": bool(button.is_pressed) if button else None,
                   "debounce_s": PRESS_DEBOUNCE,
                   "last_event": last_btn},
        "relay": {"gpio": GONG_GPIO if GONG_ENABLED else None,
                  "enabled": GONG_ENABLED,
                  "pulse_s": GONG_PULSE,
                  "state": "on" if (GONG_ENABLED and gong.dev
                                    and gong.dev.value == 1.0) else "off",
                  "last_event": last_rel},
        "sensor": snap,
        "mqtt": {"connected": mqtt_connected, "broker": BROKER},
        "call_active": call_active,
        "events": {"buffer": EVENT_BUFFER, "button": len(btn),
                   "relay": len(rel)},
    }


@api.get("/api/sensor")
def api_sensor():
    return SENSOR.snapshot() if SENSOR else {"error": "Sensor deaktiviert"}


@api.post("/api/button/press")
def api_button_press():
    entry = handle_press("api")
    return {"ok": entry is not None, "event": entry}


@api.post("/api/relay/pulse")
def api_relay_pulse():
    entry = gong.pulse(source="api", trigger="test", button_event_id=None)
    return {"ok": entry is not None and entry["success"], "event": entry}


@api.get("/api/events/button")
def api_events_button(limit: int = 100):
    with _events_lock:
        items = list(button_events)
    items.reverse()
    return {"count": len(items), "since": STARTED_AT, "events": items[:max(1, min(limit, EVENT_BUFFER))]}


@api.get("/api/events/relay")
def api_events_relay(limit: int = 100):
    with _events_lock:
        items = list(relay_events)
    items.reverse()
    return {"count": len(items), "since": STARTED_AT, "events": items[:max(1, min(limit, EVENT_BUFFER))]}


@api.get("/api/events")
def api_events(limit: int = 100):
    with _events_lock:
        btn = list(button_events)
        rel = list(relay_events)
    btn.reverse()
    rel.reverse()
    return {
        "since": STARTED_AT,
        "button": btn[:max(1, min(limit, EVENT_BUFFER))],
        "relay": rel[:max(1, min(limit, EVENT_BUFFER))],
    }


