# --------------------------------------------------------------- SHTC3-Sensor
def crc8(data):
    crc = 0xFF
    for byte in data:
        crc ^= byte
        for _ in range(8):
            crc = ((crc << 1) ^ 0x31) & 0xFF if crc & 0x80 else (crc << 1) & 0xFF
    return crc


class Shtc3Sensor(threading.Thread):
    """Liest den SHTC3 zyklisch (Wakeup -> Messung -> Schlaf)."""

    def __init__(self, bus, addr, interval):
        super().__init__(daemon=True, name="shtc3")
        self.bus_path = bus
        self.addr = addr
        self.interval = interval
        self.data = {"temperature_c": None, "humidity_pct": None,
                     "ts": None, "time": None, "error": "keine Messung"}
        self._lock = threading.Lock()

    def _init_sensor(self):
        """Einmalige Initialisierung: wecken (NACK im Schlaf!), Reset, ID."""
        fd = os.open(self.bus_path, os.O_RDWR)
        try:
            fcntl.ioctl(fd, 0x0703, self.addr)

            def cmd(c):
                os.write(fd, bytes([c >> 8, c & 0xFF]))

            cmd(0x3517)  # Wakeup — im Schlafmodus NACKt der SHTC3 alles andere
            time.sleep(0.002)
            cmd(0x805D)  # Soft Reset
            time.sleep(0.002)
            cmd(0xEFC8)  # ID lesen
            time.sleep(0.002)
            raw = os.read(fd, 3)
            chip = struct.unpack(">H", raw[:2])[0] & 0x083F
            if chip != 0x807:
                raise OSError("SHTC3 nicht erkannt (ID 0x%03X)" % chip)
        finally:
            os.close(fd)

    def _read_once(self):
        fd = os.open(self.bus_path, os.O_RDWR)
        try:
            fcntl.ioctl(fd, 0x0703, self.addr)

            def cmd(c):
                os.write(fd, bytes([c >> 8, c & 0xFF]))

            # Wake zuerst, sonst EIO (NACK) im Schlafmodus.
            cmd(0x3517)  # Wakeup
            time.sleep(0.002)
            cmd(0x7866)  # Messung, T zuerst, ohne Clock Stretching
            time.sleep(0.015)
            data = os.read(fd, 6)
            if len(data) != 6:
                raise OSError("zu wenige Bytes: %d" % len(data))
            if crc8(data[0:2]) != data[2] or crc8(data[3:5]) != data[5]:
                raise OSError("CRC-Fehler")
            raw_t = struct.unpack(">H", data[0:2])[0]
            raw_h = struct.unpack(">H", data[3:5])[0]
            temp = (((4375 * raw_t) >> 14) - 4500) / 100.0
            hum = ((625 * raw_h) >> 12) / 100.0
            cmd(0xB098)  # Sleep
            return temp, hum
        finally:
            os.close(fd)

    def run(self):
        try:
            self._init_sensor()
            print("SHTC3 erkannt (ID 0x807)", flush=True)
        except Exception as exc:
            print("SHTC3 init fehlgeschlagen: %s" % exc, flush=True)
        while True:
            temp = hum = None
            error = None
            for _ in range(2):  # ein Retry faengt Einzelfehler ab
                try:
                    temp, hum = self._read_once()
                    error = None
                    break
                except Exception as exc:
                    error = str(exc)
                    time.sleep(0.2)
            if temp is not None:
                with self._lock:
                    self.data = {"temperature_c": round(temp, 2),
                                 "humidity_pct": round(hum, 1),
                                 "ts": time.time(), "time": now_iso(),
                                 "error": None}
                m_temperature.set(temp)
                m_humidity.set(hum)
                m_sensor_up.set(1)
            else:
                with self._lock:
                    self.data = {"temperature_c": None, "humidity_pct": None,
                                 "ts": time.time(), "time": now_iso(),
                                 "error": error}
                m_sensor_up.set(0)
            time.sleep(self.interval)

    def snapshot(self):
        with self._lock:
            data = dict(self.data)
        if data.get("ts"):
            m_sensor_age.set(max(0.0, time.time() - data["ts"]))
        return data


# ------------------------------------------------------- Schallpegel-Messung
class LevelMeter(threading.Thread):
    """Misst den RMS-Pegel (dBFS) aus dem Mikrofon-Stream und schaetzt den
    Schalldruck. Ein zusaetzlicher ffmpeg-Prozess dekodiert Opus -> PCM
    (16 kHz mono) und dieser Thread wertet 125-ms-Bloecke aus."""

    N = 2000  # Samples pro Block (125 ms bei 16 kHz)

    def __init__(self):
        super().__init__(daemon=True, name="level")
        self._lock = threading.Lock()
        self.data = {"dbfs": None, "db_spl": None, "peak_dbfs": None,
                     "error": "keine Messung"}
        self._smooth = None
        self._peak = None

    def run(self):
        import select
        n = self.N
        while True:
            proc = None
            try:
                # Rohmikrofon (rawmic PCM) direkt lesen — ohne AEC/NS,
                # damit die Anzeige die akustische Realitaet zeigt.
                env = dict(os.environ)
                env["XDG_RUNTIME_DIR"] = LEVEL_XDG_RUNTIME
                proc = subprocess.Popen(
                    ["ffmpeg", "-hide_banner", "-loglevel", "error",
                     "-f", "alsa", "-i", LEVEL_SOURCE,
                     "-f", "s16le", "-ar", "16000",
                     "-ac", "1", "-"],
                    stdout=subprocess.PIPE, env=env)
                fd = proc.stdout.fileno()
                buf = bytearray()
                while True:
                    r, _, _ = select.select([fd], [], [], 5.0)
                    if not r:
                        raise OSError("keine Audio-Daten (Timeout)")
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        raise OSError("Level-Stream beendet")
                    buf += chunk
                    while len(buf) >= n * 2:
                        raw = bytes(buf[:n * 2])
                        del buf[:n * 2]
                        samples = struct.unpack("<%dh" % n, raw)
                        acc = 0
                        for v in samples:
                            acc += v * v
                        rms = math.sqrt(acc / n) / 32768.0
                        dbfs = (20.0 * math.log10(rms)
                                if rms > 0 else -90.0)
                        with self._lock:
                            self._smooth = (
                                dbfs if self._smooth is None
                                else 0.7 * self._smooth + 0.3 * dbfs)
                            if self._peak is None or dbfs > self._peak:
                                self._peak = dbfs
                            self.data = {
                                "dbfs": round(self._smooth, 1),
                                "db_spl": round(self._smooth + LEVEL_SPL_OFFSET),
                                "peak_dbfs": (round(self._peak, 1)
                                               if self._peak is not None
                                               else None),
                                "error": None,
                            }
                        m_sound_dbfs.set(self.data["dbfs"])
                        m_sound_spl.set(self.data["db_spl"])
                        m_sound_peak.set(self.data["peak_dbfs"])
            except Exception as exc:  # noqa: BLE001 — Messung darf nie crashen
                with self._lock:
                    self.data = {"dbfs": None, "db_spl": None,
                                 "peak_dbfs": (round(self._peak, 1)
                                               if self._peak is not None
                                               else None),
                                 "error": str(exc)}
                if proc is not None:
                    try:
                        proc.kill()
                    except Exception:
                        pass
                time.sleep(2)  # reconnect

    def snapshot(self):
        with self._lock:
            return dict(self.data)


# ----------------------------------------------- Mikrofon-Empfindlichkeit
class MicControl(threading.Thread):
    """Mikrofon-Empfindlichkeit am INMP441 einstellen und beobachten.

    Der Sollwert ist das Node-Volume des soc_sound-Quellenknotens in der
    PipeWire-Session des Users intercom (wpctl-Skala, kubisch: linear
    = v^3). Der Daemon laeuft als root und ruft wpctl per runuser in der
    Session auf. Aenderungen wirken live auf den Opus-Stream
    (intercom-cam-audio) und den Pegelmesser.

    Persistenz: Der Wert wird in MIC_VOLUME_FILE gespeichert und beim
    naechsten Session-Start von set-mic-volume.service wieder gesetzt.
    Ein Hintergrund-Thread haelt Cache und Prometheus-Metrik aktuell.
    """

    REFRESH = 15.0  # s
    CACHE_AGE = 10.0  # s: gueltiges Alter des Snapshot-Caches

    def __init__(self):
        super().__init__(daemon=True, name="mic-ctl")
        self._lock = threading.Lock()
        self._node_id = None
        self._cache = {"volume": None, "node": None, "live": False,
                       "error": "kein Abruf"}
        self._cache_ts = 0.0

    # ---- Hilfsmittel ------------------------------------------------
    def _session_cmd(self, prog, args):
        """Kommando in der PipeWire-Session des intercom-Users bauen."""
        runuser = shutil.which("runuser") or "/usr/sbin/runuser"
        return [runuser, "-u", MIC_USER, "--", "env",
                "XDG_RUNTIME_DIR=/run/user/%d" % MIC_UID,
                "HOME=" + MIC_HOME, prog] + list(args)

    def _wpctl(self, *args):
        """wpctl in der intercom-Session ausfuehren -> (rc, kombinierte
        Ausgabe)."""
        try:
            r = subprocess.run(self._session_cmd("wpctl", list(args)),
                               capture_output=True, text=True, timeout=10)
            return r.returncode, (r.stdout or "") + (r.stderr or "")
        except Exception as exc:  # noqa: BLE001
            return 127, str(exc)

    def _discover(self):
        """Node-ID des Mikrofons suchen (IDs wechseln zwischen Restarts).

        Gleiche Logik wie set-mic-volume.sh: Quellen-Sektion des
        wpctl-status scannen und Kandidaten per wpctl inspect gegen den
        Node-Namen pruefen.
        """
        rc, out = self._wpctl("status")
        if rc != 0:
            return None
        in_sources = False
        for line in out.splitlines():
            if "Sources:" in line:
                in_sources = True
                continue
            if in_sources and ("Filters:" in line or "Sinks" in line):
                break
            if not in_sources:
                continue
            for m in re.finditer(r"(\d+)\.", line):
                node_id = m.group(1)
                rc2, out2 = self._wpctl("inspect", node_id)
                if rc2 == 0 and 'node.name = "%s"' % MIC_NODE in out2:
                    return node_id
        return None

    @staticmethod
    def _read_file():
        """Persistierten Sollwert lesen (letzter Wert aus der WebGUI)."""
        try:
            with open(MIC_VOLUME_FILE, "r") as fh:
                return round(float(fh.read().strip()), 2)
        except Exception:
            return MIC_DEFAULT

    @staticmethod
    def _write_file(volume):
        """Sollwert atomar persistieren; Datei gehoert danach intercom."""
        tmp = MIC_VOLUME_FILE + ".tmp"
        with open(tmp, "w") as fh:
            fh.write("%.2f\n" % volume)
        os.replace(tmp, MIC_VOLUME_FILE)
        os.chmod(MIC_VOLUME_FILE, 0o644)
        try:
            pwent = pwd.getpwnam(MIC_USER)
            os.chown(MIC_VOLUME_FILE, pwent.pw_uid, pwent.pw_gid)
        except Exception:  # noqa: BLE001 — chown ist optional
            pass

    def _cache_update(self, data):
        with self._lock:
            self._cache = data
            self._cache_ts = time.time()

    # ---- Oeffentliche Schnittstelle ---------------------------------
    def read(self, force=False):
        """Aktuellen Volume lesen: live wenn moeglich, sonst Datei."""
        if not force:
            with self._lock:
                if (self._cache.get("live")
                        and time.time() - self._cache_ts <= self.CACHE_AGE):
                    return dict(self._cache)
        data = self._read_live()
        self._cache_update(data)
        return data

    def _read_live(self):
        node = self._node_id or self._discover()
        if not node:
            return {"volume": self._read_file(), "node": None, "live": False,
                    "error": "Mikrofon-Quelle nicht gefunden"}
        self._node_id = node
        rc, out = self._wpctl("get-volume", node)
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if m:
            return {"volume": round(float(m.group(1)), 2), "node": node,
                    "live": True, "error": None}
        self._node_id = None
        return {"volume": self._read_file(), "node": None, "live": False,
                "error": "Volume nicht lesbar"}

    def set(self, volume):
        """Volume setzen (wpctl-Skala, MIC_MIN..MIC_MAX) und persistieren."""
        try:
            volume = round(float(volume), 2)
        except (TypeError, ValueError):
            raise ValueError("volume muss eine Zahl sein")
        if not (MIC_MIN <= volume <= MIC_MAX):
            raise ValueError(
                "Volume muss zwischen %s und %s liegen"
                % (MIC_MIN, MIC_MAX))
        for attempt in (0, 1):
            if attempt:
                self._node_id = None  # Session evtl. neu gestartet
            node = self._node_id or self._discover()
            if not node:
                break
            self._node_id = node
            self._wpctl("set-volume", node, "%.2f" % volume)
            rc, out = self._wpctl("get-volume", node)
            m = re.search(r"Volume:\s*([\d.]+)", out)
            if m and abs(float(m.group(1)) - volume) < 0.01:
                self._write_file(volume)
                data = {"volume": volume, "node": node, "live": True,
                        "error": None}
                self._cache_update(data)
                return data
        # Quelle nicht erreichbar: zumindest fuer den naechsten Start
        # persistieren (set-mic-volume.service setzt den Wert dann neu).
        self._write_file(volume)
        data = {"volume": volume, "node": None, "live": False,
                "error": "Quelle nicht erreichbar - nur gespeichert"}
        self._cache_update(data)
        return data

    # ---- Hintergrund-Thread -------------------------------------------
    def run(self):
        while True:
            try:
                data = self._read_live()
                if data.get("live") and data.get("volume") is not None:
                    m_mic_volume.set(data["volume"])
            except Exception as exc:  # noqa: BLE001 — darf nie crashen
                data = {"volume": None, "node": None, "live": False,
                        "error": str(exc)}
            self._cache_update(data)
            time.sleep(self.REFRESH)


def mic_db(volume):
    """Verstaerkung in dB relativ zu 1.0 (wpctl-Skala: linear = v^3)."""
    if volume is None or volume <= 0:
        return None
    return round(60.0 * math.log10(volume), 1)


# ------------------------------------------------------------------ MQTT
client = None


def mqtt_publish(topic, payload, retain=False):
    if client is None:
        return
    try:
        client.publish(topic, json.dumps(payload), qos=1, retain=retain)
    except Exception as exc:  # noqa: BLE001 — MQTT darf nie crashen
        print("mqtt publish failed: %s" % exc, flush=True)


def on_connect(cl, userdata, flags, rc, properties=None):
    global mqtt_connected
    if rc == 0:
        mqtt_connected = True
        m_mqtt_connected.set(1)
        cl.publish(TOPIC_PRESENCE, "online", qos=1, retain=True)
        cl.subscribe("intercom/indoor/+/state", qos=1)
        print("mqtt connected", flush=True)
    else:
        mqtt_connected = False
        m_mqtt_connected.set(0)


def on_disconnect(cl, userdata, flags=None, rc=None, properties=None):
    global mqtt_connected
    mqtt_connected = False
    m_mqtt_connected.set(0)


def on_message(cl, userdata, msg):
    global call_active
    try:
        payload = json.loads(msg.payload.decode())
    except Exception:
        return
    call = payload.get("call")
    call_active = call == "active"
    m_call_active.set(1 if call_active else 0)
    # Klingel beendet, wenn die Innenseite abnimmt (active) oder in den
    # Idle-Zustand zurueckfaellt (Ring-Timeout / Auflegen) — nur waehrend
    # die Innenseite selbst im Klingel-Modus steht, bleibt die 1 stehen.
    if call_active or call == "idle":
        m_call_ringing.set(0)


def mqtt_setup():
    global client
    try:
        client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2,
                             client_id="intercom-door")
    except AttributeError:  # aeltere paho-Version ohne CallbackAPIVersion
        client = mqtt.Client(client_id="intercom-door")
    client.will_set(TOPIC_PRESENCE, "offline", qos=1, retain=True)
    client.tls_set(ca_certs=CA)
    client.username_pw_set(USER, PASSWORD)
    client.on_connect = on_connect
    client.on_disconnect = on_disconnect
    client.on_message = on_message
    # Kein Crash bei DNS-/Netz-Fehlern: Verbindung im Netzwerk-Thread.
    client.reconnect_delay_set(min_delay=1, max_delay=30)
    client.connect_async(BROKER, PORT, keepalive=30)
    client.loop_start()


# ------------------------------------------------------------------ Events
def record_button_event(source, event, call):
    with _events_lock:
        entry = {
            "id": next(_event_ids),
            "ts": round(time.time(), 3),
            "time": now_iso(),
            "source": source,
            "event": event,
            "call": call,
            "relay_event_id": None,
        }
        button_events.append(entry)
    m_button_presses.labels(event=event, source=source).inc()
    return entry


def record_relay_event(source, trigger, button_event_id, success, pin_on):
    with _events_lock:
        entry = {
            "id": next(_event_ids),
            "ts": round(time.time(), 3),
            "time": now_iso(),
            "source": source,
            "trigger": trigger,
            "duration_s": GONG_PULSE,
            "success": success,
            "pin_state_on": pin_on,
            "pin_state_off": None,
            "button_event_id": button_event_id,
        }
        relay_events.append(entry)
    m_relay_pulses.labels(source=source,
                          success="1" if success else "0").inc()
    if not success:
        m_relay_failures.inc()
    mqtt_publish(TOPIC_RELAY, {
        "event": "activated" if success else "failed",
        "source": source,
        "trigger": trigger,
        "duration_s": GONG_PULSE,
        "success": success,
        "button_event_id": button_event_id,
        "ts": entry["ts"],
    })
    return entry


# ------------------------------------------------------------------ Gong
class Gong:
    """Gong-Relais mit Puls, Retrigger und Software-Feedback."""

    def __init__(self):
        self.dev = None
        self.timer = None
        self.lock = threading.Lock()
        if GONG_ENABLED:
            self.dev = OutputDevice(GONG_GPIO, active_high=GONG_ACTIVE_HIGH,
                                    initial_value=False)

    def _off(self, entry):
        with self.lock:
            self.timer = None
            if self.dev is None:
                return
            try:
                self.dev.off()
                ok = self.dev.value == 0.0
            except Exception:
                ok = False
            if entry is not None:
                entry["pin_state_off"] = ok

    def pulse(self, source, trigger, button_event_id):
        if self.dev is None:
            return None
        entry = None
        success = False
        pin_on = None
        try:
            with self.lock:
                if self.timer is not None:
                    self.timer.cancel()
                self.dev.on()
                pin_on = (self.dev.value == 1.0)
                success = pin_on
        except Exception as exc:
            print("gong pulse failed: %s" % exc, flush=True)
        entry = record_relay_event(source, trigger, button_event_id,
                                   success, pin_on)
        if success:
            with self.lock:
                self.timer = threading.Timer(GONG_PULSE, self._off, (entry,))
                self.timer.daemon = True
                self.timer.start()
        else:
            self._off(None)
        return entry

    def shutdown(self):
        with self.lock:
            if self.timer is not None:
                self.timer.cancel()
                self.timer = None
            if self.dev is not None:
                try:
                    self.dev.off()
                except Exception:
                    pass


gong = Gong()


# -------------------------------------------------------------- Klingel-Flow
def handle_press(source):
    """Physischer oder API-Tastendruck: Event, Gong, MQTT (legacy + neu)."""
    global last_press
    now = time.time()
    if source == "button":
        if now - last_press < PRESS_DEBOUNCE:
            return None
        last_press = now
    event = "hangup" if call_active else "ring"
    call = "active" if call_active else "idle"
    entry = record_button_event(source, event, call)
    m_call_ringing.set(1 if event == "ring" else 0)
    if event == "ring" or GONG_ON_HANGUP:
        relay_entry = gong.pulse(source=source, trigger=event,
                                button_event_id=entry["id"])
        if relay_entry is not None:
            entry["relay_event_id"] = relay_entry["id"]
    mqtt_publish(TOPIC_LEGACY, {"event": event, "ts": int(now)})
    mqtt_publish(TOPIC_BUTTON, {
        "event": "press",
        "source": source,
        "result": event,
        "call": call,
        "relay_event_id": entry["relay_event_id"],
        "ts": entry["ts"],
    })
    return entry


button = None


def gpio_setup():
    global button
    button = Button(BUTTON_GPIO, pull_up=True, bounce_time=BUTTON_BOUNCE)
    button.when_pressed = lambda: handle_press("button")


# ------------------------------------------------------------------ API
api = FastAPI(title="intercom-door", version=APP_VERSION)


@api.get("/metrics")
def api_metrics():
    m_uptime.set(time.time() - STARTED_TS)
    from fastapi.responses import Response
    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)


@api.get("/api/status")
def api_status():
    snap = SENSOR.snapshot() if SENSOR else {}
    with _events_lock:
        btn = list(button_events)
        rel = list(relay_events)
    last_btn = btn[-1] if btn else None
    last_rel = rel[-1] if rel else None
    return {
        "version": APP_VERSION,
        "started_at": STARTED_AT,
        "started_ts": STARTED_TS,
        "uptime_s": round(time.time() - STARTED_TS, 1),
        "button": {"gpio": BUTTON_GPIO,
                   "pressed": bool(button.is_pressed) if button else None,
                   "debounce_s": PRESS_DEBOUNCE,
                   "last_event": last_btn},
        "relay": {"gpio": GONG_GPIO if GONG_ENABLED else None,
                  "enabled": GONG_ENABLED,
                  "pulse_s": GONG_PULSE,
                  "state": "on" if (GONG_ENABLED and gong.dev
                                    and gong.dev.value == 1.0) else "off",
                  "last_event": last_rel},
        "sensor": snap,
        "level": LEVEL.snapshot() if LEVEL else {},
        "mqtt": {"connected": mqtt_connected, "broker": BROKER},
        "call_active": call_active,
        "events": {"buffer": EVENT_BUFFER, "button": len(btn),
                   "relay": len(rel)},
    }


@api.get("/api/sensor")
def api_sensor():
    return SENSOR.snapshot() if SENSOR else {"error": "Sensor deaktiviert"}


@api.get("/api/level")
def api_level():
    if LEVEL:
        return LEVEL.snapshot()
    return {"dbfs": None, "db_spl": None, "peak_dbfs": None,
            "error": "Pegelmesser deaktiviert"}


@api.get("/api/mic")
def api_mic_get():
    """Aktuelle Mikrofon-Empfindlichkeit (wpctl-Skala, kubisch)."""
    if not MIC:
        return {"volume": None, "db_gain": None, "node": None, "live": False,
                "default": MIC_DEFAULT, "error": "Mikrofon-Steuerung deaktiviert"}
    data = MIC.read()
    data["db_gain"] = mic_db(data.get("volume"))
    data["default"] = MIC_DEFAULT
    if data.get("live") and data.get("volume") is not None:
        m_mic_volume.set(data["volume"])
    return data


@api.post("/api/mic")
def api_mic_set(data: dict):
    """Mikrofon-Empfindlichkeit setzen (wpctl-Skala, 0..MAX).

    Body: {"volume": 2.5} — wirkt live und wird ueber MIC_VOLUME_FILE
    persistiert (set-mic-volume.service setzt es nach Reboots neu).
    """
    if not MIC:
        return {"ok": False, "error": "Mikrofon-Steuerung deaktiviert"}
    try:
        result = MIC.set(data.get("volume"))
    except ValueError as exc:
        return {"ok": False, "error": str(exc)}
    result["ok"] = bool(result.get("live"))
    result["db_gain"] = mic_db(result.get("volume"))
    if result.get("volume") is not None:
        m_mic_volume.set(result["volume"])
    return result


@api.post("/api/button/press")
def api_button_press():
    entry = handle_press("api")
    return {"ok": entry is not None, "event": entry}


@api.post("/api/relay/pulse")
def api_relay_pulse():
    entry = gong.pulse(source="api", trigger="test", button_event_id=None)
    return {"ok": entry is not None and entry["success"], "event": entry}


@api.get("/api/events/button")
def api_events_button(limit: int = 100):
    with _events_lock:
        items = list(button_events)
    items.reverse()
    return {"count": len(items), "since": STARTED_AT, "events": items[:max(1, min(limit, EVENT_BUFFER))]}


@api.get("/api/events/relay")
def api_events_relay(limit: int = 100):
    with _events_lock:
        items = list(relay_events)
    items.reverse()
    return {"count": len(items), "since": STARTED_AT, "events": items[:max(1, min(limit, EVENT_BUFFER))]}


@api.get("/api/events")
def api_events(limit: int = 100):
    with _events_lock:
        btn = list(button_events)
        rel = list(relay_events)
    btn.reverse()
    rel.reverse()
    return {
        "since": STARTED_AT,
        "button": btn[:max(1, min(limit, EVENT_BUFFER))],
        "relay": rel[:max(1, min(limit, EVENT_BUFFER))],
    }


