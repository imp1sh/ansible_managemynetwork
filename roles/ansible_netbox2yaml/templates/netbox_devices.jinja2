---
{% if nb_devices_fetched is defined %}
nb_devices:
{% for device in nb_devices_fetched %}
  "{{ device.value.name }}":
    id: {{ device.key }}
{% if device.value.description != "" %}
    description: "{{ device.value.description }}"
{% endif %}
{% if device.value.comment is defined and device.value.comment != "" %}
    comments: "{{ device.value.comment }}"
{% endif %}
{% if device.value.role is defined %}
    device_role: {{ device.value.role | default('""', true) }}
{% endif %}
    device_type: {{ device.value.device_type }}
    primary_ip4: "{{ device.value.primary_ip4.address | default("") }}"
    primary_ip6: "{{ device.value.primary_ip6.address | default("") }}"
{% if device.value.serial is defined and device.value.serial != "" %}
    serial: "{{ device.value.serial }}"
{% endif %}
    site: {{ device.value.site | default({}, true) }}
    status: "{{ device.value.status.value | default("") }}"
    interfaces:
{% for interface in dict_interfaces[device.key|int]|default([], true) %}
      {{ interface.name }}:
{% if interface.mac_address is defined %}
        mac: {{ interface.mac_address }}
{% endif %}
{% set _ips = (dict_ips | default({}))[interface.ips|int] | default([], true) %}
{% set _ip4 = _ips | selectattr('family', 'eq', 4) | sort(attribute='ip_id') | map(attribute='address') | list %}
{% set _ip6 = _ips | selectattr('family', 'eq', 6) | sort(attribute='ip_id') | map(attribute='address') | list %}
{% set _ip6_ula = _ip6 | select('match', '^[fF][cCdD]') | list %}
{% set _ip6_gua = _ip6 | select('match', '^[23]') | list %}
{% set _ip6_ll = _ip6 | select('match', '^[fF][eE][89aAbB]') | list %}
{% if _ip4 | length > 0 %}
        ip4:
{% for addr in _ip4 %}
          ip4_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% else %}
        ip4: {}
{% endif %}
{% if (_ip6_ula | length) + (_ip6_gua | length) + (_ip6_ll | length) > 0 %}
        ip6:
{% for addr in _ip6_ula %}
          ula_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% for addr in _ip6_gua %}
          gua_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% for addr in _ip6_ll %}
          ll_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% else %}
        ip6: {}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
