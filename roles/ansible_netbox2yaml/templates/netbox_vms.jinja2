---
{% if nb_vms_fetched is defined %}
nb_vms:
{% for vm in nb_vms_fetched %}
  "{{ vm.value.name }}":
    id: {{ vm.key }}
{% if vm.value.description != "" %}
    description: "{{ vm.value.description }}"
{% endif %}
{% if vm.value.comment is defined and vm.value.comment != "" %}
    comments: "{{ vm.value.comment }}"
{% endif %}
    vm_role: {{ vm.value.role | default('""', true) }}
    primary_ip4: "{{ vm.value.primary_ip4.address | default("") }}"
    primary_ip6: "{{ vm.value.primary_ip6.address | default("") }}"
    site: {{ vm.value.site | default({}, true) }}
    status: "{{ vm.value.status.value | default("") }}"
    interfaces:
{% for interface in dict_interfaces[vm.key|int]|default([], true) %}
      {{ interface.name }}:
{% if interface.mac is defined and interface.mac %}
        mac: {{ interface.mac }}
{% endif %}
{% set _ips = (dict_ips | default({}))[interface.ips|int] | default([], true) %}
{% set _ip4 = _ips | selectattr('family', 'eq', 4) | sort(attribute='ip_id') | map(attribute='address') | list %}
{% set _ip6 = _ips | selectattr('family', 'eq', 6) | sort(attribute='ip_id') | map(attribute='address') | list %}
{% set _ip6_ula = _ip6 | select('match', '^[fF][cCdD]') | list %}
{% set _ip6_gua = _ip6 | select('match', '^[23]') | list %}
{% set _ip6_ll = _ip6 | select('match', '^[fF][eE][89aAbB]') | list %}
{% if _ip4 | length > 0 %}
        ip4:
{% for addr in _ip4 %}
          ip4_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% else %}
        ip4: {}
{% endif %}
{% if (_ip6_ula | length) + (_ip6_gua | length) + (_ip6_ll | length) > 0 %}
        ip6:
{% for addr in _ip6_ula %}
          ula_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% for addr in _ip6_gua %}
          gua_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% for addr in _ip6_ll %}
          ll_{{ loop.index0 }}: {{ addr }}
{% endfor %}
{% else %}
        ip6: {}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
